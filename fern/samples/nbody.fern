// An N-body simulation: a disk of stars wheeling around a heavy core, each
// pulling on every other by gravity. That's n² pulls a step; Barnes and
// Hut's octree makes it about n log n. Space is a cube, cut into eight
// cubes, each of those into eight, until each holds at most one star, and
// each cube knows its mass and its center of mass. A cube that's small
// next to how far away it is (its size under θ times its distance) pulls
// like one star at its center of mass, so most of the sky is a few dozen
// pulls, not hundreds.
//
// The numbers are fixed point (Fx, below), with the operators' traits, so
// the physics reads like physics; and it's integers underneath, so it
// prints the same everywhere.

// ---- numbers: x / 2^24 (so a product of two is good up to about 180)

#[derive(Eq)]
struct Fx { raw: Int }

fn bits() -> Int { 24 }

impl Fx {
    fn of(n: Int) -> Fx { Fx { raw: n << bits() } }
    // n / d
    fn ratio(n: Int, d: Int) -> Fx { Fx { raw: (n << bits()) / d } }
    fn zero() -> Fx { Fx { raw: 0 } }
    fn abs(self) -> Fx { Fx { raw: self.raw.abs() } }
    fn sqrt(self) -> Fx { Fx { raw: isqrt(self.raw << bits()) } }
    // to the nearest integer
    fn round(self) -> Int { (self.raw + (1 << (bits() - 1))) >> bits() }
    // as a percentage, to two places: "12.50%"
    fn percent(self) -> String {
        let hundredths = (self.raw * 10000 + (1 << (bits() - 1))) >> bits();
        (hundredths / 100).show() ++ "." ++ (hundredths % 100).show().pad_left(2, "0") ++ "%"
    }
}

impl Add for Fx { fn add(self, o: Fx) -> Fx { Fx { raw: self.raw + o.raw } } }
impl Sub for Fx { fn sub(self, o: Fx) -> Fx { Fx { raw: self.raw - o.raw } } }
impl Mul for Fx { fn mul(self, o: Fx) -> Fx { Fx { raw: self.raw * o.raw >> bits() } } }
impl Div for Fx { fn div(self, o: Fx) -> Fx { Fx { raw: (self.raw << bits()) / o.raw } } }
impl Neg for Fx { fn neg(self) -> Fx { Fx { raw: -self.raw } } }
impl Num for Fx {}
impl Ord for Fx { fn cmp(self, o: Fx) -> Int { self.raw.cmp(o.raw) } }

// to three places
impl Show for Fx {
    fn show(self) -> String {
        let thousandths = (self.raw.abs() * 1000 + (1 << (bits() - 1))) >> bits();
        let sign = if self.raw < 0 && thousandths > 0 { "-" } else { "" };
        sign ++ (thousandths / 1000).show() ++ "." ++ (thousandths % 1000).show().pad_left(3, "0")
    }
}

// the largest integer whose square is at most n (Newton's method, from a
// power of two at least as big)
fn isqrt(n: Int) -> Int {
    if n < 2 {
        n.max(0)
    } else {
        let mut x = 1;
        let mut m = n;
        while m > 0 {
            m = m >> 2;
            x = x << 1;
        }
        let mut y = (x + n / x) / 2;
        while y < x {
            x = y;
            y = (x + n / x) / 2;
        }
        x
    }
}

// ---- vectors

#[derive(Eq)]
struct V3 { x: Fx, y: Fx, z: Fx }

impl V3 {
    fn zero() -> V3 { V3 { x: Fx::zero(), y: Fx::zero(), z: Fx::zero() } }
    fn scale(self, k: Fx) -> V3 { V3 { x: self.x * k, y: self.y * k, z: self.z * k } }
    fn dot(self, o: V3) -> Fx { self.x * o.x + self.y * o.y + self.z * o.z }
    // (from the squares of the raw numbers, which would round away to
    // nothing in fixed point for a short vector)
    fn len(self) -> Fx { Fx { raw: isqrt(self.x.raw * self.x.raw + self.y.raw * self.y.raw + self.z.raw * self.z.raw) } }
}

impl Add for V3 { fn add(self, o: V3) -> V3 { V3 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z } } }
impl Sub for V3 { fn sub(self, o: V3) -> V3 { V3 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z } } }
impl Neg for V3 { fn neg(self) -> V3 { V3 { x: -self.x, y: -self.y, z: -self.z } } }

// ---- gravity (G is 1)

struct Star { id: Int, mass: Fx, pos: V3, vel: V3 }

// (so two stars passing close don't fling each other off to infinity)
fn softening() -> Fx { Fx::ratio(1, 20) }

// how mass m at `to` accelerates something at `at`: m r / |r|³
fn attract(at: V3, to: V3, m: Fx) -> V3 {
    let r = to - at;
    let d2 = r.dot(r) + softening() * softening();
    r.scale(m / d2 / d2.sqrt())
}

// every other star's pull on s, one by one
fn direct(stars: List<Star>, s: Star) -> V3 {
    stars.fold(V3::zero(), |a, o| if o.id == s.id { a } else { a + attract(s.pos, o.pos, o.mass) })
}

// ---- the octree

struct Cell { mass: Fx, center: V3, size: Fx, kids: List<Octree> }

enum Octree { Empty, Single(Star), Inner(Cell) }

// the tree of stars inside the cube around `mid`, `half` its size across
fn build(stars: List<Star>, mid: V3, half: Fx) -> Octree {
    match stars {
        Nil => Empty,
        Cons(s, Nil) => Single(s),
        _ => {
            let mass = stars.fold(Fx::zero(), |m, s| m + s.mass);
            let center = stars.fold(V3::zero(), |c, s| c + s.pos.scale(s.mass)).scale(Fx::of(1) / mass);
            // (stars too close to tell apart are just listed)
            let kids = if half.raw < 64 {
                stars.map(|s| Single(s))
            } else {
                (0..8).to_list().map(|k| build(stars.filter(|s| octant(s.pos, mid) == k), corner(mid, half, k), half / Fx::of(2)))
            };
            Inner(Cell { mass: mass, center: center, size: half * Fx::of(2), kids: kids })
        }
    }
}

// which of the eight cubes around mid p is in: a bit for each axis
fn octant(p: V3, mid: V3) -> Int {
    (if p.x < mid.x { 0 } else { 1 }) + (if p.y < mid.y { 0 } else { 2 }) + (if p.z < mid.z { 0 } else { 4 })
}

// the middle of cube k of the eight around mid
fn corner(mid: V3, half: Fx, k: Int) -> V3 {
    let q = half / Fx::of(2);
    let side = |bit| if k & bit == 0 { -q } else { q };
    mid + V3 { x: side(1), y: side(2), z: side(4) }
}

// the tree of all the stars, in a cube around the origin big enough for them
fn tree(stars: List<Star>) -> Octree {
    let far = stars.fold(Fx::of(1), |h, s| h.max(s.pos.x.abs()).max(s.pos.y.abs()).max(s.pos.z.abs()));
    build(stars, V3::zero(), far + Fx::ratio(1, 16))
}

// whether cell c is small enough, seen from p, to pull as one star
fn distant(c: Cell, p: V3, theta: Fx) -> Bool {
    let r = c.center - p;
    c.size * c.size < theta * theta * r.dot(r)
}

// the pull on s of everything in the tree
fn pull(t: Octree, s: Star, theta: Fx) -> V3 {
    match t {
        Empty => V3::zero(),
        Single(o) => if o.id == s.id { V3::zero() } else { attract(s.pos, o.pos, o.mass) },
        Inner(c) => if distant(c, s.pos, theta) {
            attract(s.pos, c.center, c.mass)
        } else {
            c.kids.fold(V3::zero(), |a, k| a + pull(k, s, theta))
        }
    }
}

// how many pulls that is
fn pulls(t: Octree, s: Star, theta: Fx) -> Int {
    match t {
        Empty => 0,
        Single(o) => if o.id == s.id { 0 } else { 1 },
        Inner(c) => if distant(c, s.pos, theta) { 1 } else { c.kids.fold(0, |n, k| n + pulls(k, s, theta)) }
    }
}

// ---- moving

// a step of dt: each star's velocity by its acceleration, then its place
// by its new velocity (semi-implicit Euler, which keeps orbits closed)
fn step(stars: List<Star>, dt: Fx, theta: Fx) -> List<Star> {
    let t = tree(stars);
    stars.map(|s| {
        let vel = s.vel + pull(t, s, theta).scale(dt);
        Star { id: s.id, mass: s.mass, pos: s.pos + vel.scale(dt), vel: vel }
    })
}

// kinetic plus potential
fn energy(stars: List<Star>) -> Fx {
    let kinetic = stars.fold(Fx::zero(), |e, s| e + s.mass * s.vel.dot(s.vel) / Fx::of(2));
    kinetic + potential(stars, Fx::zero())
}

fn potential(stars: List<Star>, sum: Fx) -> Fx {
    match stars {
        Nil => sum,
        Cons(s, rest) => potential(rest, rest.fold(sum, |e, o| {
            let r = o.pos - s.pos;
            e - s.mass * o.mass / (r.dot(r) + softening() * softening()).sqrt()
        }))
    }
}

fn momentum(stars: List<Star>) -> V3 {
    stars.fold(V3::zero(), |p, s| p + s.vel.scale(s.mass))
}

// ---- the galaxy

// a core of mass 1, and n stars weighing a fifth as much between them, in
// a thin disk from radius 1 to 5, each going around about as fast as a
// circular orbit would (from the mass inside it); the core moves just
// enough the other way that the whole doesn't drift
fn galaxy(n: Int) -> List<Star> {
    let mut seed = 2024;
    // a pseudo-random fraction from lo to hi
    let random = |lo: Fx, hi: Fx| {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        lo + (hi - lo) * Fx { raw: seed >> (31 - bits()) }
    };
    let disk = Fx::ratio(1, 5);
    let mut stars = [];
    let mut id = 1;
    while id <= n {
        let x = random(Fx::of(-5), Fx::of(5));
        let y = random(Fx::of(-5), Fx::of(5));
        let z = random(Fx::ratio(-1, 20), Fx::ratio(1, 20));
        let r = (x * x + y * y).sqrt();
        // (only those in the ring)
        if r >= Fx::of(1) && r <= Fx::of(5) {
            let inside = Fx::of(1) + disk * (r - Fx::of(1)) / Fx::of(4);
            let speed = (inside / r).sqrt();
            let around = V3 { x: -y / r, y: x / r, z: Fx::zero() };
            stars = Cons(Star { id: id, mass: disk / Fx::of(n), pos: V3 { x: x, y: y, z: z }, vel: around.scale(speed) }, stars);
            id = id + 1;
        }
    }
    Cons(Star { id: 0, mass: Fx::of(1), pos: V3::zero(), vel: -momentum(stars) }, stars)
}

// the stars from above, as text: brighter where they're thicker
fn picture(stars: List<Star>, w: Int, h: Int, extent: Fx) -> List<String> {
    let counts = Array::new(w * h, 0);
    stars.each(|s| {
        let col = ((s.pos.x + extent) * Fx::of(w) / (extent * Fx::of(2))).round();
        let row = ((s.pos.y + extent) * Fx::of(h) / (extent * Fx::of(2))).round();
        if col >= 0 && col < w && row >= 0 && row < h {
            counts.set(row * w + col, counts.get(row * w + col) + 1);
        }
    });
    let shades = " .:+*#@";
    (0..h).to_list().map(|row| {
        let cells = (0..w).to_list().map(|col| shades.char_at(counts.get(row * w + col).min(6)));
        "|" ++ String::from_chars(cells) ++ "|"
    })
}

fn main() {
    let n = 200;
    let theta = Fx::ratio(1, 2);
    let stars = galaxy(n);
    println((n + 1).show() ++ " bodies");

    // how good the octree's guess is, against every pull one by one: of the
    // disk's own gravity (the core's is always exact, being off on its own)
    let disk = stars.filter(|s| s.id != 0);
    let t = tree(disk);
    let used = disk.fold(0, |k, s| k + pulls(t, s, theta));
    let error = disk.fold(Fx::zero(), |e, s| {
        let exact = direct(disk, s);
        e + (pull(t, s, theta) - exact).len() / exact.len()
    }) / Fx::of(n);
    println("the disk's pull on itself: " ++ (n * (n - 1)).show() ++ " pulls one by one; " ++ used.show() ++ " with the octree (θ = " ++ theta.show() ++ "), off by " ++ error.percent() ++ " on average");

    let before = energy(stars);
    println("energy " ++ before.show() ++ ", momentum " ++ momentum(stars).len().show());
    picture(stars, 48, 24, Fx::of(6)).each(println);

    let dt = Fx::ratio(1, 25);
    let steps = 80;
    let after = (0..steps).fold(stars, |s, _| step(s, dt, theta));
    let now = energy(after);
    println("after " ++ steps.show() ++ " steps (t = " ++ (dt * Fx::of(steps)).show() ++ "): energy " ++ now.show() ++ " (off by " ++ ((now - before) / before).abs().percent() ++ "), momentum " ++ momentum(after).len().show());
    picture(after, 48, 24, Fx::of(6)).each(println);
}
