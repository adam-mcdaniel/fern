// Traits: a trait of our own, impls for our types and for type
// constructors (with a requirement on the parameter), a supertrait, a
// default method, and generic functions with bounds.

trait Shape {
    fn area(self) -> Int;
    fn name(self) -> String;
    // a default method: every Shape has it
    fn describe(self) -> String { self.name() ++ " of area " ++ self.area().show() }
}

struct Rect { w: Int, h: Int }
struct Square { side: Int }

impl Shape for Rect {
    fn area(self) -> Int { self.w * self.h }
    fn name(self) -> String { "rectangle" }
}

impl Shape for Square {
    fn area(self) -> Int { self.side * self.side }
    fn name(self) -> String { "square" }
    fn describe(self) -> String { "a square, side " ++ self.side.show() }
}

// a bound: any T with a Shape impl
fn total_area<T: Shape>(shapes: List<T>) -> Int {
    shapes.fold(0, |sum, s| sum + s.area())
}

// a trait with a supertrait: anything Pretty is Show too
trait Pretty: Show {
    fn pretty(self) -> String { "<" ++ self.show() ++ ">" }
}

impl Pretty for Int {}

// an impl for every Option<T> whose T is Pretty
impl<T: Pretty> Pretty for Option<T> {
    fn pretty(self) -> String {
        match self { Some(x) => "some " ++ x.pretty(), None => "nothing" }
    }
}

// no annotation: inferred to need Show (and nothing else) of its argument
fn twice(x) { x.show() ++ x.show() }

fn main() {
    println(Rect { w: 3, h: 4 }.describe());
    println(Square { side: 5 }.describe());
    println(total_area([Rect { w: 1, h: 2 }, Rect { w: 3, h: 3 }]).show());
    println(42.pretty());
    println(Some(7).pretty());
    println(twice(true) ++ twice("ab"));
    println([3, 1, 2].show());
    println([5, 3, 8, 1].sort().show());
    println(["pear", "apple", "fig"].sort().show());
}
// expect: rectangle of area 12
// expect: a square, side 5
// expect: 11
// expect: <42>
// expect: some <7>
// expect: truetrue"ab""ab"
// expect: [3, 1, 2]
// expect: [1, 3, 5, 8]
// expect: ["apple", "fig", "pear"]
