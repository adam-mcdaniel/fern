// The standard library: maps and sets, and effects (failing, state,
// generators and search).

fn maps() {
    let m = Map::from_list([("banana", 3), ("apple", 5), ("cherry", 7)]);
    let m2 = m.remove("banana").insert("date", 1);
    println(m.show() ++ " " ++ m2.show() ++ " " ++ m.get("apple").show() ++ " " ++ m2.get("banana").show() ++ " " ++ m2.len().show());
    let counts = "mississippi".chars().fold(Map::new(), |acc, c| acc.update(c.to_char(), |n| Some(n.unwrap_or(0) + 1)));
    println(counts.show() ++ " " ++ counts.keys().show() ++ " " ++ counts.map(|n| n * n).values().show());
    // a thousand keys in, every other one out: still in order, still all there
    let big = (0..1000).fold(Map::new(), |acc, k| acc.insert(k * 7 % 1000, k));
    let half = (0..500).fold(big, |acc, k| acc.remove(k * 2));
    println(big.len().show() ++ " " ++ half.len().show() ++ " " ++ half.keys().take(5).show() ++ " " ++ half.get(999).show() ++ " " ++ (m == Map::from_list(m.to_list())).show());
    let s = Set::from_list([3, 1, 4, 1, 5, 9, 2, 6]);
    let t = Set::from_list([1, 2, 3, 10]);
    println(s.show() ++ " " ++ s.union(t).show() ++ " " ++ s.intersection(t).show() ++ " " ++ s.difference(t).show() ++ " " ++ s.contains(9).show());
}

// ---- effects

fn safe_div(a: Int, b: Int) -> Int with {Fail} {
    if b == 0 { fail("divided by zero") } else { a / b }
}

fn counter() -> Int with {State<Int>} {
    modify(|n| n + 10);
    put(get() * 2);
    get() + 1
}

fn fibs(n: Int) with {Yield<Int>} {
    let mut a = 0;
    let mut b = 1;
    let mut i = 0;
    while i < n {
        yield(a);
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
}

// the pairs of digits adding to 10, the first smaller
fn ten() -> (Int, Int) with {Choose} {
    let a = choose(0..10);
    let b = choose(0..10);
    guard(a < b && a + b == 10);
    (a, b)
}

fn effects() {
    println(attempt(|| safe_div(10, 2)).show() ++ " " ++ attempt(|| safe_div(1, 0)).show() ++ " " ++ or_default(|| safe_div(1, 0), -1).show());
    println(attempt(|| need("12".parse_int(), "no number") + need("x".parse_int(), "not a number")).show());
    println(run_state(5, counter).show());
    println(collect(|| fibs(10)).show());
    for_each(|| fibs(5), |x| print(x.show() ++ ";"));
    println("");
    println(all_ways(ten).show() ++ " " ++ first_way(|| choose_from(["x", "y"]) ++ choose_from(["1", "2"])).show());
}

fn main() {
    maps();
    effects();
}
// expect: {"apple": 5, "banana": 3, "cherry": 7} {"apple": 5, "cherry": 7, "date": 1} Some(5) None 3
// expect: {"i": 4, "m": 1, "p": 2, "s": 4} ["i", "m", "p", "s"] [16, 1, 4, 16]
// expect: 1000 500 [1, 3, 5, 7, 9] Some(857) true
// expect: {1, 2, 3, 4, 5, 6, 9} {1, 2, 3, 4, 5, 6, 9, 10} {1, 2, 3} {4, 5, 6, 9} true
// expect: Ok(5) Err("divided by zero") -1
// expect: Err("not a number")
