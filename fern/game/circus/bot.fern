// The autopilot: plays the acts on the title screen, and proves in the
// tests that every act can be finished (and how tightly).
//
// It plays by looking ahead. On each swing it tries letting go at every
// moment of the next two seconds, on a copy of Stella, holding again
// whenever a hook comes in reach, and finds what's best to do: onto the
// end platform, else to the farthest hook caught. Of all the moments that
// do that it picks the middle one, the safest. How good it is (`skill`,
// out of 256) is how near that moment it lets go.

use super::acts::*;
use super::body::*;

pub struct Bot { release_at: Int, plan_hook: Int, skill: Int, seed: Int, wobble: Int, replan: Int }

pub fn bot(skill: Int) -> Bot { Bot { release_at: -1, plan_hook: -1, skill: skill, seed: 17, wobble: 0, replan: -1 } }

fn copy_of(s: Stella) -> Stella {
    let c = Stella { x: s.x, y: s.y, vx: s.vx, vy: s.vy, state: s.state, hook: s.hook, rope: s.rope, angle: s.angle, spin: s.spin, tuck: false, turned: 0, plat: s.plat, t: s.t, squash: 0, sx: array(scarf_len(), s.x), sy: array(scarf_len(), s.y) };
    c
}

// how a release after k frames turns out: where she gets to, as a number
// (higher better): the end, a platform to rest on farther along (better
// than the hooks just past it: the act was made through it), a hook
// farther along, or the net
pub fn try_release(s: Stella, a: Act, k: Int, t: Int, sines: Array<Int>) -> Int {
    let c = copy_of(s);
    let mut f = 0;
    let mut result = -1;
    let start_hook = s.hook;
    let mut was = true;
    while f < k + 220 && result < 0 {
        let held = if f < k { true } else {
            // (in the air, hold when a hook ahead's in reach)
            c.state == s_air() && f > k + 2 && target(c, a, t + f, sines) > start_hook
        };
        let ev = move_stella(c, a, held, held && !was, t + f, sines);
        was = held;
        if c.state == s_done() { result = 100000 }
        else if c.state == s_fallen() { result = 0 }
        else if f > k && c.state == s_swing() && c.hook != start_hook { result = 1000 + a.hx.get(c.hook) }
        else if f > k && c.state == s_stand() { result = if c.plat > s.plat { 1400 + a.px1.get(c.plat) } else { 500 } }
        f = f + 1;
    }
    result.max(0)
}

fn roll(b: Bot, n: Int) -> Int {
    b.seed = (b.seed * 1103515245 + 12345) & 0x7fffffff;
    (b.seed >> 16) % n.max(1)
}

// what the bot does with the button this frame: (held, pressed) packed
// as held * 2 + pressed
pub fn think(b: Bot, s: Stella, a: Act, t: Int, sines: Array<Int>) -> Int {
    let st = s.state;
    if st == s_stand() {
        if s.t > 20 { 3 } else { 0 }
    } else if st == s_swing() {
        if s.hook != b.plan_hook || (b.replan >= 0 && s.t >= b.replan) {
            // a new swing: find the best moment to let go
            b.plan_hook = s.hook;
            // (the best that letting go can do; then the middle of the
            // longest run of moments that do it, the safest moment)
            let outcomes = array(120, 0);
            let mut top = -1;
            let mut k = 1;
            while k < 120 {
                let sc = try_release(s, a, k, t, sines);
                outcomes.set(k, sc);
                if sc > top { top = sc }
                k = k + 1;
            }
            let mut best = 1;
            let mut run = 0;
            let mut longest = 0;
            let mut j = 1;
            while j < 120 {
                if outcomes.get(j) == top {
                    run = run + 1;
                    if run > longest { longest = run; best = j - run / 2; }
                } else { run = 0 }
                j = j + 1;
            }
            let spread = (256 - b.skill) / 32;
            b.wobble = if spread > 0 { roll(b, spread * 2 + 1) - spread } else { 0 };
            if top > 0 {
                b.release_at = s.t + best + b.wobble;
                b.replan = -1;
            } else {
                // (nothing works from this swing yet: keep swinging, she
                // pumps it higher, and think again in a while)
                b.release_at = s.t + 100000;
                b.replan = s.t + 40;
            }
        }
        if s.t >= b.release_at { 0 } else { 2 }
    } else if st == s_air() {
        // hold when a new hook's in reach
        let h = target(s, a, t, sines);
        if h >= 0 && h > b.plan_hook && s.t > 2 { 3 } else { 0 }
    } else { 0 }
}
