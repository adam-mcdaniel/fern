// Numbers without floats: fixed point, where a number x stands for
// x / 65536 (so one() is 1), angles in 1024ths of a turn, square roots of
// integers, and pseudo-random numbers.

pub fn one() -> Int { 65536 }

// a * b, and a / b, in fixed point
pub fn mul(a: Int, b: Int) -> Int { a * b >> 16 }
pub fn div(a: Int, b: Int) -> Int { (a << 16) / b }

pub fn abs(n: Int) -> Int { if n < 0 { -n } else { n } }
pub fn clamp(n: Int, lo: Int, hi: Int) -> Int { if n < lo { lo } else if n > hi { hi } else { n } }

// the largest integer whose square is at most n (Newton's method, from a
// power of two at least as big)
pub fn isqrt(n: Int) -> Int {
    if n < 2 {
        n.max(0)
    } else {
        let mut x = 1;
        let mut m = n;
        while m > 0 {
            m = m >> 2;
            x = x << 1;
        }
        let mut y = (x + n / x) / 2;
        while y < x {
            x = y;
            y = (x + n / x) / 2;
        }
        x
    }
}

// the square root of a fixed-point number
pub fn sqrt(a: Int) -> Int { isqrt(a << 16) }

// ---- angles

// a table of sines, in fixed point, for angles in 1024ths of a turn
pub fn sines() -> Array<Int> {
    let t = array(1024, 0);
    let mut i = 0;
    while i <= 256 {
        let s = quarter_sine(i);
        array_set(t, i, s);
        array_set(t, 512 - i, s);
        array_set(t, 512 + i & 1023, -s);
        array_set(t, 1024 - i & 1023, -s);
        i = i + 1;
    }
    t
}

pub fn sin(table: Array<Int>, a: Int) -> Int { array_get(table, a & 1023) }
pub fn cos(table: Array<Int>, a: Int) -> Int { array_get(table, a + 256 & 1023) }

// sin(x) = x - x^3/3! + x^5/5! - ..., for the first quarter turn
fn quarter_sine(i: Int) -> Int {
    // (2 pi is 411775 in fixed point)
    let x = i * 411775 / 1024;
    let x2 = mul(x, x);
    let mut term = x;
    let mut sum = x;
    let mut k = 1;
    while k < 7 {
        term = -mul(term, x2) / (2 * k * (2 * k + 1));
        sum = sum + term;
        k = k + 1;
    }
    sum
}

// ---- random numbers

// a generator: its state is the array's one cell
pub fn rng(seed: Int) -> Array<Int> { array(1, seed) }

// a number from 0 to n - 1
pub fn random(r: Array<Int>, n: Int) -> Int {
    let s = array_get(r, 0) * 1103515245 + 12345 & 0x7fffffff;
    array_set(r, 0, s);
    (s >> 16) % n
}
