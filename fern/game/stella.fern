// THE AMAZING STELLA. A trapeze act under the big top, played with one
// button: hold to grab the nearest hook, let go to fly. Swing, fling,
// chain catches for speed, tuck into flips for the crowd, fly through
// hoops of ribbon, pop balloons, and land on the far platform on your
// feet. Thirty acts in three tours (the Big Top, the Seaside Pier, the
// Winter Carnival), each with three stars to earn (finish, beat the
// time, show the style), and the Encore, acts without end. Saved.
//
// The button: the mouse, Space, Enter, Z, or a controller's A. Holding
// in the air with no hook near tucks Stella into a spin. Escape (or
// Start) for the intermission; F11 fills the screen.
//
// It's made of the parts in circus/: the acts and how they're made by
// trying them (acts, maker), Stella's body and her swing (body), the act
// in play (play), the pictures (gfx, font, scene, ui), the flourishes
// (fx), the band and the crowd (sound), what's kept (save), and the
// autopilot that performs on the title screen and teaches the first
// acts' timing (bot); and a little C of its own for the keyboard:
//
// links: circus/platform.c

mod screen;
mod draw;
mod math;
mod circus;

use screen::*;
use math::{sines};
use circus::gfx::*;
use circus::font::{letters};
use circus::sound::{volumes};
use circus::app::*;
use circus::save;

extern fn scan_down(code: Int) -> Bool;

struct Ptr { mx: Int, my: Int, stick: Int }

fn read_input(p: Ptr) -> Input with Io {
    let mx = mouse_x();
    let my = mouse_y();
    let moved = mx != p.mx || my != p.my;
    p.mx = mx;
    p.my = my;
    let ax = pad_axis(0);
    let ay = pad_axis(1);
    let dir = if ay < -16000 { 1 } else if ay > 16000 { 2 } else if ax < -16000 { 3 } else if ax > 16000 { 4 } else { 0 };
    let fresh = dir != p.stick;
    p.stick = dir;
    Input {
        // (the one button, held: the mouse, Space, Enter, Z, or A)
        held: mouse_down() || scan_down(44) || scan_down(40) || scan_down(29) || pad_down(0),
        ok: key_pressed(key_enter()) || key_pressed(key_space()) || key_pressed(key("z")) || pad_pressed(0),
        back: key_pressed(key_escape()) || key_pressed(key_backspace()) || pad_pressed(1) || pad_pressed(6),
        up: key_pressed(key_up()) || key_pressed(key("w")) || pad_pressed(11) || (fresh && dir == 1),
        down: key_pressed(key_down_arrow()) || key_pressed(key("s")) || pad_pressed(12) || (fresh && dir == 2),
        west: key_pressed(key_left()) || key_pressed(key("a")) || pad_pressed(13) || (fresh && dir == 3),
        east: key_pressed(key_right()) || key_pressed(key("d")) || pad_pressed(14) || (fresh && dir == 4),
        mx: mx, my: my, click: mouse_clicked(), moved: moved,
        full: key_pressed(key_f11()),
    }
}

fn main() {
    if !screen_open(sw(), sh(), 3, "THE AMAZING STELLA") {
        panic("couldn't open a window\n");
    }
    let data = save::load();
    volumes(save::get(data, save::sv_music()), save::get(data, save::sv_sfx()));
    if save::get(data, save::sv_full()) > 0 { screen_full(true) }
    let g = gfx(letters());
    rect(g, 0, 0, sw(), sh(), 0x2a0a1a);
    say_mid(g, "THE AMAZING STELLA", 240, 120, 2, 0xffc830, 0x6a1a10);
    screen_show(g.px);
    let p = app(data, sines(), true);
    let ptr = Ptr { mx: 0, my: 0, stick: 0 };
    loop {
        frame(p, read_input(ptr), g);
        if p.quit { break; }
        if !screen_show(g.px) { break; }
    }
}
