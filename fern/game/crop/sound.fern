// The sound: an effect for everything that happens on the table, and
// music, made up as it plays.
//
// The music is a little string band. Chords go round, a bar each: a
// plucked banjo rolls through each chord in eighths and sixteenths, a
// bass walks root and fifth on the beats ("boom") under a muted strum on
// the off-beats ("chuck"), brushes keep time, and a whistled tune made
// from the scale wanders over the top, its phrases repeating the way
// folk tunes do (the same line twice, an answer, the line again). Each
// season has its key and its pace: spring bright and quick in G, summer
// easy in D, autumn wistful in A minor, winter slow in E minor, with a
// soft pad under it like snow. The fair's music is faster and has a
// kick drum. As the basket grows, the band plays harder.
//
// Notes are scheduled a little ahead on the sound's own clock, so the
// beat stays exact however the frames fall.

use crate::screen::{note, note_swept, sound_clock, sound_volume, sound_stop};
use super::fx::*;

pub struct Music { freqs: Array<Int>, song: Int, season: Int, next: Int, step: Int, tune_seed: Int }

pub fn music() -> Music {
    // each MIDI note's frequency in 16ths of a hertz: the octave from
    // middle C, doubled and halved
    let ratios = [1000, 1059, 1122, 1189, 1260, 1335, 1414, 1498, 1587, 1682, 1782, 1888];
    let r = Array::from_list(ratios, 0);
    let freqs = array(128, 0);
    let mut n = 0;
    while n < 128 {
        let base = 4186 * r.get(n % 12) / 1000;
        let oct = n / 12 - 5;
        freqs.set(n, if oct >= 0 { base << oct } else { base >> (-oct) });
        n = n + 1;
    }
    Music { freqs: freqs, song: -1, season: 0, next: 0, step: 0, tune_seed: 7 }
}

// the songs
pub fn s_title() -> Int { 0 }
pub fn s_week() -> Int { 1 }
pub fn s_fair() -> Int { 2 }
pub fn s_market() -> Int { 3 }
pub fn s_victory() -> Int { 4 }
pub fn s_lost() -> Int { 5 }
pub fn s_silence() -> Int { 6 }

fn sine() -> Int { 0 }
fn triangle() -> Int { 1 }
fn square() -> Int { 2 }
fn saw() -> Int { 3 }
fn noise() -> Int { 4 }
fn pluck() -> Int { 5 }
fn pad() -> Int { 6 }
fn pulse() -> Int { 7 }

fn hz(m: Music, n: Int) -> Int { m.freqs.get(n.clamp(0, 127)) }

fn play(wave: Int, f: Int, f_end: Int, at: Int, attack: Int, length: Int, vol: Int, pan: Int, cutoff: Int, reverb: Int, bus: Int) with Io {
    note(wave, f, f_end, at, attack, length, vol, pan, cutoff, reverb, bus);
}

fn swept(wave: Int, f: Int, f_end: Int, at: Int, attack: Int, length: Int, vol: Int, pan: Int, cutoff: Int, cutoff_end: Int, reverb: Int, bus: Int) with Io {
    note_swept(wave, f, f_end, at, attack, length, vol, pan, cutoff, cutoff_end, reverb, bus);
}

// a degree of a scale as semitones (0 major, 1 natural minor, 2 dorian)
fn degree(scale: Int, d: Int) -> Int {
    let steps = if scale == 0 { [0, 2, 4, 5, 7, 9, 11] } else if scale == 1 { [0, 2, 3, 5, 7, 8, 10] } else { [0, 2, 3, 5, 7, 9, 10] };
    let oct = d.div_floor(7);
    let k = d.mod_floor(7);
    steps.get(k).unwrap_or(0) + oct * 12
}

fn mhash(a: Int, b: Int, c: Int) -> Int {
    let mut h = a * 374761393 + b * 668265263 + c * 1274126177;
    h = (h ^ (h >> 13)) * 1274126177;
    (h ^ (h >> 16)) & 0xffff
}

// keeps the music going: what's due in the next quarter second, played
pub fn tick(m: Music, song: Int, season: Int, intensity: Int) with Io {
    let now = sound_clock();
    if m.song != song || (m.season != season && song == s_week()) {
        sound_stop(0);
        m.song = song;
        m.season = season;
        m.next = now + 100;
        m.step = 0;
        m.tune_seed = mhash(now, song, season) % 97;
    }
    if song != s_silence() {
        let step_ms = step_length(song, season);
        let mut next = m.next;
        if next < now - 500 { next = now + 50 }
        while next < now + 260 {
            beat(m, song, season, m.step, next, step_ms, intensity);
            m.step = m.step + 1;
            next = next + step_ms;
        }
        m.next = next;
    }
}

fn step_length(song: Int, season: Int) -> Int {
    if song == s_title() { 150 } else if song == s_fair() { 112 } else if song == s_market() { 160 }
    else if song == s_victory() { 120 } else if song == s_lost() { 220 }
    else if season == 0 { 128 } else if season == 1 { 136 } else if season == 2 { 150 } else { 168 }
}

// one sixteenth of a song
fn beat(m: Music, song: Int, season: Int, step: Int, at: Int, sl: Int, intensity: Int) with Io {
    let s = step % 16;
    let bar = step / 16;
    // the key (a MIDI root), the scale, the chords' roots (as degrees)
    let key = if song == s_title() { 55 } else if song == s_fair() { 48 } else if song == s_market() { 53 }
        else if song == s_victory() { 50 } else if song == s_lost() { 45 }
        else if season == 0 { 55 } else if season == 1 { 50 } else if season == 2 { 57 } else { 52 };
    let scale = if song == s_lost() { 1 } else if song == s_week() && season == 2 { 2 } else if song == s_week() && season == 3 { 1 } else { 0 };
    let prog = if song == s_title() { [0, 3, 0, 4] } else if song == s_fair() { [0, 3, 4, 0, 0, 3, 4, 4] }
        else if song == s_market() { [0, 5, 3, 4] } else if song == s_victory() { [0, 3, 4, 0] } else if song == s_lost() { [0, 5, 3, 4] }
        else if season == 0 { [0, 3, 0, 4, 0, 3, 4, 0] } else if season == 1 { [0, 4, 5, 3] } else if season == 2 { [0, 6, 3, 4] } else { [0, 5, 3, 6] };
    let chord = prog.get(bar % prog.len()).unwrap_or(0);
    let tone = |d: Int| key + degree(scale, chord + d);
    let bar_ms = sl * 16;
    let drive = if song == s_fair() { 3 } else if song == s_week() { intensity.clamp(0, 3) } else if song == s_victory() { 2 } else { 0 };
    let soft = song == s_market() || song == s_lost();
    // the pad under it all: softer in summer, more in winter
    if s == 0 && (season == 3 || song == s_title() || soft) {
        let vol = if season == 3 && song == s_week() { 36 } else { 24 };
        swept(pad(), hz(m, tone(0) + 12), hz(m, tone(0) + 12), at, bar_ms / 3, bar_ms + bar_ms / 3, vol, -30, 500, 1100, 200, 0);
        swept(pad(), hz(m, tone(2) + 12), hz(m, tone(2) + 12), at, bar_ms / 3, bar_ms + bar_ms / 3, vol, 30, 500, 1100, 200, 0);
    }
    // the banjo: a forward roll through the chord (thumb, index, middle),
    // eighths, or sixteenths when it's going
    let roll = [0, 4, 7, 2, 4, 7, 0, 4];
    let fast = drive >= 2 || song == s_title();
    if song != s_lost() && (s % 2 == 0 || fast) {
        let i = if fast { s % 8 } else { (s / 2) % 8 };
        let d = roll.get(i).unwrap_or(0);
        let n = tone(d) + 12;
        let accent = if s % 4 == 0 { 92 } else { 66 };
        let vol = if soft { accent * 2 / 3 } else { accent };
        play(pluck(), hz(m, n), hz(m, n), at, 1, sl * 3, vol, if i % 2 == 0 { -25 } else { 25 }, 5200, 70, 0);
    }
    if song == s_lost() && s % 4 == 0 {
        let d = [4, 2, 1, 0].get((s / 4) % 4).unwrap_or(0);
        play(pluck(), hz(m, tone(d) + 12), hz(m, tone(d) + 12), at, 1, sl * 8, 90, 0, 3000, 160, 0);
    }
    // boom-chuck: the bass on the beats, a muted strum between
    if s % 4 == 0 && song != s_lost() {
        let n = if s % 8 == 0 { tone(0) - 12 } else { tone(4) - 12 };
        play(triangle(), hz(m, n), hz(m, n), at, 4, sl * 3, if soft { 100 } else { 140 }, 0, 900, 20, 0);
    }
    if s % 4 == 2 && !soft {
        play(pluck(), hz(m, tone(2)), hz(m, tone(2)), at, 1, sl, 40, 10, 1600, 30, 0);
        play(pluck(), hz(m, tone(4)), hz(m, tone(4)), at, 1, sl, 34, -10, 1600, 30, 0);
    }
    // brushes, and more drums as it gets going
    if s % 2 == 0 && song != s_lost() {
        play(noise(), 8000 * 16, 8000 * 16, at, 2, if s % 4 == 2 { 70 } else { 30 }, if s % 4 == 2 { 22 } else { 12 }, 30, 7000, 40, 0);
    }
    if drive >= 1 && s % 4 == 2 {
        swept(noise(), 3000 * 16, 3000 * 16, at, 1, 110, 50 + drive * 10, -10, 5000, 1500, 60, 0);
    }
    if drive >= 2 && (s == 0 || s == 8 || (drive >= 3 && (s == 4 || s == 12))) {
        play(sine(), 140 * 16, 45 * 16, at, 1, 180, 200, 0, 1500, 10, 0);
    }
    // the whistled tune: a phrase of two bars, played as A A B A
    let phrase = (bar / 2) % 4;
    let line = if phrase == 2 { 1 } else { 0 };
    let in_bar = (bar % 2) * 16 + s;
    let rhythm = mhash(m.tune_seed, line, in_bar / 2) % 100;
    let sounding = song != s_market() && (song != s_week() || drive >= 1 || bar % 8 >= 4) && in_bar % 2 == 0 && rhythm < (if song == s_title() { 45 } else { 55 });
    if sounding {
        let d = (mhash(m.tune_seed + 13, line, in_bar / 2) % 7) + (if in_bar < 4 { 0 } else { 2 }) - 2;
        // (leaning toward the chord's own notes on the strong beats)
        let dd = if in_bar % 8 == 0 { (d / 2) * 2 } else { d };
        let n = key + 24 + degree(scale, chord + dd);
        let len = sl * (if rhythm < 20 { 4 } else { 2 });
        let wave = if song == s_fair() { pulse() } else { sine() };
        swept(wave, hz(m, n) * 31 / 32, hz(m, n), at, 20, len, if song == s_fair() { 50 } else { 70 }, 15, 3000, 1800, 150, 0);
        // (a breath of noise with it, for the whistle)
        play(noise(), hz(m, n) * 2, hz(m, n) * 2, at, 20, len * 2 / 3, 8, 15, 4000, 100, 0);
    }
    if song == s_victory() && bar % 2 == 1 && (s == 0 || s == 4 || s == 8 || s == 10) {
        let n = tone(s / 2) + 24;
        swept(square(), hz(m, n), hz(m, n), at, 4, sl * 3, 50, 10, 4200, 1500, 170, 0);
    }
}

pub fn volumes(music_vol: Int, sfx_vol: Int) with Io { sound_volume(music_vol, sfx_vol) }

// ---- the effects

// the sounds the play asked for this frame, a few of each at most
pub fn effects(m: Music, f: Fx) with Io {
    let seen = array(64, 0);
    let mut i = 0;
    while i < f.n_sounds {
        let what = f.sounds.get(i * 3);
        let k = f.sounds.get(i * 3 + 1);
        let pan = f.sounds.get(i * 3 + 2);
        let most = if what == sn_harvest() || what == sn_wall() { 3 } else if what == sn_tick() { 1 } else { 2 };
        if what >= 0 && what < 64 && seen.get(what) < most {
            seen.set(what, seen.get(what) + 1);
            effect(m, what, k, pan);
        }
        i = i + 1;
    }
    f.n_sounds = 0;
}

pub fn effect(m: Music, what: Int, k: Int, pan: Int) with Io {
    let now = sound_clock();
    let jitter = (now * 7919) % 100;
    if what == sn_flip() {
        // the flipper: a solenoid's clunk
        play(square(), 150 * 16, 70 * 16, 0, 1, 40, 70, pan, 1200, 10, 1);
        play(noise(), 2500 * 16, 800 * 16, 0, 1, 25, 50, pan, 4000, 10, 1);
    } else if what == sn_wall() {
        // a knock on wood
        play(triangle(), (260 + jitter) * 16, 130 * 16, 0, 1, 40, (20 + k * 6).min(90), pan, 2500, 20, 1);
    } else if what == sn_bumper() {
        // a springy boing
        swept(sine(), (380 + k * 60) * 16, (220 + k * 30) * 16, 0, 1, 140, 110, pan, 3000, 800, 50, 1);
        play(noise(), 1200 * 16, 400 * 16, 0, 1, 30, 30, pan, 2500, 20, 1);
    } else if what == sn_hay() {
        // a hay bale: a soft thump and rustle
        play(sine(), (220 + k * 40) * 16, 110 * 16, 0, 1, 120, 150, pan, 1500, 40, 1);
        swept(noise(), 5000 * 16, 2000 * 16, 0, 1, 90, 50, pan, 6000, 1500, 40, 1);
    } else if what == sn_sling() {
        play(square(), 700 * 16, 300 * 16, 0, 1, 50, 60, pan, 3000, 30, 1);
        play(noise(), 3000 * 16, 1000 * 16, 0, 1, 40, 50, pan, 5000, 20, 1);
    } else if what == sn_grow() {
        // growing: a plucked note, higher as it nears ripe
        let penta = [0, 2, 4, 7, 9, 12, 14, 16, 19];
        let n = 67 + penta.get(k.clamp(0, 8)).unwrap_or(0);
        play(pluck(), hz(m, n), hz(m, n), 0, 1, 260, 80, pan, 5000, 60, 1);
    } else if what == sn_ripe() {
        // ripe: a little bell
        play(sine(), hz(m, 91), hz(m, 91), 0, 1, 500, 70, pan, 8000, 160, 1);
        play(triangle(), hz(m, 98), hz(m, 98), now + 50, 1, 400, 40, pan, 8000, 180, 1);
    } else if what == sn_harvest() {
        // a harvest: a pop, and a note climbing the scale with each in a run
        let penta = [0, 2, 4, 7, 9];
        let n = 72 + penta.get(k % 5).unwrap_or(0) + (k / 5).min(3) * 12;
        play(pluck(), hz(m, n), hz(m, n), 0, 1, 500, 120, pan, 7000, 90, 1);
        play(pluck(), hz(m, n + 7), hz(m, n + 7), now + 30, 1, 400, 60, pan, 7000, 120, 1);
        swept(sine(), 900 * 16, 300 * 16, 0, 1, 80, 90, pan, 4000, 800, 20, 1);
    } else if what == sn_bank() {
        // banked: the till rings, and coins spill
        let mut i = 0;
        while i < 5 {
            let n = 76 + degree(0, i * 2);
            play(square(), hz(m, n), hz(m, n), now + i * 45, 1, 300, 50, (i - 2) * 30, 6000, 150, 1);
            i = i + 1;
        }
        play(sine(), hz(m, 100), hz(m, 100), now + 230, 1, 900, 80, 0, 9000, 220, 1);
        let coins = 3 + k.min(10);
        i = 0;
        while i < coins {
            play(triangle(), (3000 + (i * 977) % 1600) * 16, (3000 + (i * 977) % 1600) * 16, now + 250 + i * 40, 1, 90, 34, ((i * 53) % 160) - 80, 9000, 120, 1);
            i = i + 1;
        }
        play(sine(), 120 * 16, 50 * 16, 0, 1, 300, 180, 0, 1500, 60, 1);
    } else if what == sn_drain() {
        if k == 0 {
            play(triangle(), 300 * 16, 120 * 16, 0, 1, 250, 80, pan, 2000, 60, 1);
        } else {
            // the ball lost: a long slide down
            swept(saw(), 420 * 16, 70 * 16, 0, 5, 900, 110, pan, 2400, 200, 120, 1);
            swept(saw(), 425 * 16, 72 * 16, 0, 5, 900, 70, -pan, 2400, 200, 120, 1);
        }
    } else if what == sn_lane() {
        let n = 79 + [0, 4, 7].get(k % 3).unwrap_or(0);
        play(square(), hz(m, n), hz(m, n), 0, 1, 120, 50, pan, 5000, 100, 1);
    } else if what == sn_target() {
        if k == 9 {
            play(triangle(), 200 * 16, 400 * 16, 0, 1, 160, 60, pan, 3000, 40, 1);
        } else {
            play(noise(), 2000 * 16, 600 * 16, 0, 1, 50, 90, pan, 3500, 30, 1);
            play(triangle(), (500 - k * 60) * 16, 200 * 16, 0, 1, 70, 90, pan, 3000, 30, 1);
        }
    } else if what == sn_kick() {
        play(sine(), 160 * 16, 60 * 16, 0, 1, 200, 200, pan, 1500, 40, 1);
        swept(noise(), 3000 * 16, 1000 * 16, 0, 1, 150, 60, pan, 6000, 800, 60, 1);
    } else if what == sn_plunge() {
        // the plunger drawn back: a spring creaking
        swept(saw(), 60 * 16, 110 * 16, 0, 200, 600, 30, 90, 600, 1400, 20, 1);
    } else if what == sn_launch() {
        swept(noise(), 2000 * 16, 6000 * 16, 0, 1, 250, 60 + k / 8, pan, 2000, 8000, 60, 1);
        play(sine(), 300 * 16, 600 * 16, 0, 1, 120, 90, pan, 3000, 40, 1);
    } else if what == sn_orbit() {
        swept(noise(), 1500 * 16, 1500 * 16, 0, 100, 500, 60, 0, 800, 7000, 120, 1);
        let mut i = 0;
        while i < 4 {
            play(square(), hz(m, 84 + i * 3), hz(m, 84 + i * 3), now + i * 50, 1, 120, 40, (i - 2) * 30, 6000, 120, 1);
            i = i + 1;
        }
    } else if what == sn_spin() {
        let mut i = 0;
        while i < k.min(8) {
            play(square(), 2400 * 16, 2400 * 16, now + i * 35, 1, 15, 30, pan, 6000, 20, 1);
            i = i + 1;
        }
    } else if what == sn_crow() {
        // caw (caw)
        swept(saw(), 620 * 16, 480 * 16, 0, 10, 160, 70, pan, 1800, 900, 60, 1);
        if k == 0 { swept(saw(), 600 * 16, 450 * 16, now + 220, 10, 180, 60, pan, 1800, 900, 80, 1) }
    } else if what == sn_eaten() {
        play(noise(), 1500 * 16, 300 * 16, 0, 1, 200, 90, pan, 2500, 40, 1);
        swept(saw(), 300 * 16, 120 * 16, now + 120, 5, 300, 60, pan, 1500, 300, 60, 1);
    } else if what == sn_scare() {
        let mut i = 0;
        while i < 5 {
            play(noise(), 4000 * 16, 2000 * 16, now + i * 40, 1, 30, 50, pan, 6000, 40, 1);
            i = i + 1;
        }
        swept(saw(), 700 * 16, 900 * 16, 0, 5, 140, 60, pan, 2000, 1200, 60, 1);
    } else if what == sn_coin() {
        play(square(), hz(m, 88), hz(m, 88), 0, 1, 70, 44, 0, 8000, 100, 1);
        play(square(), hz(m, 95), hz(m, 95), now + 60, 1, 220, 44, 0, 8000, 140, 1);
    } else if what == sn_save() {
        let mut i = 0;
        while i < 4 {
            play(triangle(), hz(m, 72 + degree(0, i * 2)), hz(m, 72 + degree(0, i * 2)), now + i * 60, 1, 300, 90, 0, 6000, 150, 1);
            i = i + 1;
        }
    } else if what == sn_rent() {
        // rent paid (or a farm improvement): a strummed chord and bells
        let mut i = 0;
        while i < 6 {
            play(pluck(), hz(m, 60 + degree(0, i * 2)), hz(m, 60 + degree(0, i * 2)), now + i * 30, 1, 1200, 90, (i - 3) * 25, 6000, 160, 1);
            i = i + 1;
        }
        if k == 0 {
            play(sine(), hz(m, 96), hz(m, 96), now + 250, 1, 1200, 70, 0, 9000, 220, 1);
            play(sine(), hz(m, 100), hz(m, 100), now + 400, 1, 1200, 60, 0, 9000, 220, 1);
        }
    } else if what == sn_tilt() {
        play(saw(), 90 * 16, 60 * 16, 0, 1, 900, 150, 0, 900, 30, 1);
        play(square(), 93 * 16, 61 * 16, 0, 1, 900, 80, 0, 700, 30, 1);
    } else if what == sn_warn() {
        play(pulse(), 880 * 16, 880 * 16, 0, 2, 90, 50, 0, 3000, 40, 1);
        play(pulse(), 660 * 16, 660 * 16, now + 110, 2, 120, 50, 0, 3000, 40, 1);
    } else if what == sn_multi() {
        let mut i = 0;
        while i < 8 {
            play(square(), hz(m, 67 + degree(0, i)), hz(m, 67 + degree(0, i)), now + i * 40, 1, 200, 50, (i - 4) * 20, 6000, 140, 1);
            i = i + 1;
        }
    } else if what == sn_golden() {
        let mut i = 0;
        while i < 6 {
            play(sine(), hz(m, 88 + degree(0, i * 2)), hz(m, 88 + degree(0, i * 2)), now + i * 35, 1, 400, 60, (i - 3) * 30, 9000, 200, 1);
            i = i + 1;
        }
    } else if what == sn_skill() {
        play(square(), hz(m, 79), hz(m, 79), 0, 1, 150, 60, 0, 6000, 120, 1);
        play(square(), hz(m, 84), hz(m, 84), now + 100, 1, 150, 60, 0, 6000, 120, 1);
        play(square(), hz(m, 91), hz(m, 91), now + 200, 1, 400, 60, 0, 6000, 160, 1);
    } else if what == sn_tick() {
        // produce landing in the basket (or a menu moving)
        play(triangle(), (1800 + k * 300) * 16, (1600 + k * 300) * 16, 0, 1, 30, 30, pan, 6000, 30, 1);
    } else if what == sn_mult() {
        let n = 72 + (k * 2).min(24);
        swept(square(), hz(m, n), hz(m, n + 12), 0, 1, 180, 50, pan, 3000, 7000, 120, 1);
    } else if what == sn_clack() {
        play(triangle(), 2000 * 16, 1500 * 16, 0, 1, 25, 50, 0, 7000, 20, 1);
    } else if what == sn_barn_in() {
        play(sine(), 110 * 16, 70 * 16, 0, 1, 250, 160, pan, 1200, 80, 1);
        swept(noise(), 800 * 16, 400 * 16, 0, 1, 200, 40, pan, 2000, 400, 80, 1);
    } else if what == sn_hot() {
        swept(noise(), 6000 * 16, 6000 * 16, 0, 10, 600, 50, pan, 9000, 2000, 40, 1);
        swept(saw(), 200 * 16, 800 * 16, 0, 5, 250, 50, pan, 1000, 4000, 60, 1);
    } else if what == sn_thaw() {
        let mut i = 0;
        while i < 4 {
            play(sine(), (2600 + i * 400) * 16, (2600 + i * 400) * 16, now + i * 30, 1, 200, 40, pan, 9000, 160, 1);
            i = i + 1;
        }
    } else if what == sn_tool() {
        play(triangle(), hz(m, 84), hz(m, 84), 0, 1, 300, 60, 0, 7000, 160, 1);
        play(triangle(), hz(m, 91), hz(m, 91), now + 80, 1, 400, 60, 0, 7000, 180, 1);
    }
}
