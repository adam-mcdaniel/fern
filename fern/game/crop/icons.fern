// each fair's visitor
fn fair_art(f: Int) -> List<String> {
    if f == 0 {
        // the gale: gusts
        ["................", "................", "..kkkkkkkk......", ".kccccccccck.....", "..kkkkkkkkcck....",
         "..........kck...", "...kkkkkkkkck....", "..kcccccccck.....", "...kkkkkkkk.....", "...kkkkkkk......",
         "..kcccccccck....", "...kkkkkkkcck...", ".........kcck...", "..........kk....", "................", "................"]
    } else if f == 1 {
        // the murder: a crow
        ["................", "......kkkk......", ".....knnnnk.....", "....knnnwnnk....", "....knnnnnnkyy..",
         "....knnnnnnkyyy.", "...knnGnnnnk....", "..knnGGnnnnk....", ".knnnGGGnnnk....", ".knnnnGGnnk.....",
         "..knnnnnnk......", "...kkkkkk.......", ".....y..y.......", "....yy.yy.......", "................", "................"]
    } else if f == 2 {
        // the drought: a blazing sun
        ["................", ".......y........", "...y...y...y....", "....y.kkk.y.....", ".....kyyyk......",
         "...kkyhhhykk....", "yyyky.hhh.ykyyy.", "...kkyhhhykk....", ".....kyyyk......", "....y.kkk.y.....",
         "...y...y...y....", ".......y........", "..bbBbbbBbbbB...", "..BbbBbbbBbBb...", "................", "................"]
    } else if f == 3 {
        // the frost: a snowflake
        ["................", ".......c........", "....c..c..c.....", ".....c.c.c......", "......ccc.......",
         "..c...ccc...c...", "...cccccccccc...", "..c...ccc...c...", "......ccc.......", ".....c.c.c......",
         "....c..c..c.....", ".......c........", "................", "................", "................", "................"]
    } else if f == 4 {
        // the tax man: a fat purse
        ["................", "......kkkk......", ".......kk.......", "......kttk......", ".....kttttk.....",
         "....kttttttk....", "...kttkyyktttk..", "...kttyykkttk...", "..kttttyyttttk..", "..kttkkyyttttk..",
         "..ktttkyykttttk.", "...ktttttttttk..", "....kkkkkkkkk...", "................", "................", "................"]
    } else if f == 5 {
        // the flood: waves
        ["................", "................", "....kkk.........", "..kkuuuk...kkk..", ".kuuuuuukkkuuuk.",
         "kuuccuuuuuuuuuk.", "kuuuuuuccuuuuuuk", "kkkuuuuuuuuuuukk", "kuuuukkkuuuuukuk", "kuucuuuuukkkuuuk",
         "kuuuuuuccuuuuuuk", "kUUUUUUUUUUUUUUk", "kkkkkkkkkkkkkkkk", "................", "................", "................"]
    } else if f == 6 {
        // the judge: a rosette
        ["................", ".....kkkkk......", "...kkuuuuukk....", "..kuuyyyyyuuk...", "..kuyyhhhyyuk...",
         ".kuyyhhhhhyyuk..", ".kuyyhhhhhyyuk..", ".kuyyhhhhhyyuk..", "..kuyyhhhyyuk...", "..kuuyyyyyuuk...",
         "...kkuukuukk....", "....kuuk.kuuk...", "....kuk...kuk...", "....kk.....kk...", "................", "................"]
    } else if f == 7 {
        // the short day: a clock
        ["................", ".....kkkkkk.....", "...kkwwwwwwkk...", "..kwwwwkwwwwwk..", "..kwwwwkwwwwwk..",
         ".kwwwwwkwwwwwwk.", ".kwwwwwkwwwwwwk.", ".kwwwwwkkkkkwwk.", ".kwwwwwwwwwwwwk.", "..kwwwwwwwwwwk..",
         "..kwwwwwwwwwwk..", "...kkwwwwwwkk...", ".....kkkkkk.....", "................", "................", "................"]
    } else {
        // lord goose
        [".....kkkkkk.....", ".....knnnnk.....", ".....knnnnk.....", "....krrrrrrk....", "...kkkkkkkkkk...",
         "....kwwwwwwk....", "...kwwgggwwwk...", "...kwwgnkwwwkoo.", "...kwwgggwwoooo.", "...kwwwwwwwwkoo.",
         "....kwwwwwwk....", ".....kwwwwk.....", ".....kwwwwk.....", "....kwwwwwwk....", "................", "................"]
    }
}

// the pictures made, into the picture's own store of them
pub fn load_icons(g: Gfx) {
    let a = array(tool_count() + 9, blank(1, 1));
    let mut t = 0;
    while t < tool_count() {
        a.set(t, sprite(art(t), keys(), colors()));
        t = t + 1;
    }
    let mut f = 0;
    while f < 9 {
        a.set(tool_count() + f, sprite(fair_art(f), keys(), colors()));
        f = f + 1;
    }
    g.tool_art = a;
}

// fair f's visitor, with its top left at (x, y), on a red tag
pub fn fair_icon(g: Gfx, f: Int, x: Int, y: Int) {
    tag_square(g, x, y, 22, 0xd85a4a);
    let i = tool_count() + f;
    if i < g.tool_art.len() {
        let s = g.tool_art.get(i);
        draw_shadow(g, s, x + 4, y + 4, 90);
        draw(g, s, x + 3, y + 3);
    }
}

// tool t's picture on its tag, with its top left at (x, y)
pub fn tool_icon(g: Gfx, t: Int, x: Int, y: Int) {
    tag_square(g, x, y, 22, tool_color(t));
    if t < g.tool_art.len() {
        let s = g.tool_art.get(t);
        draw_shadow(g, s, x + 4, y + 4, 90);
        draw(g, s, x + 3, y + 3);
    }
}

fn tag_square(g: Gfx, x: Int, y: Int, s: Int, color: Int) {
    round_rect(g, x, y, s, s, 3, scale(color, 170));
    round_rect(g, x + 1, y + 1, s - 2, s - 2, 2, color);
    rect(g, x + 3, y + 1, s - 6, 1, mix(color, 0xffffff, 100));
}

// an improvement's picture: a ball, a shield, a plot, a sack
pub fn good_icon(g: Gfx, k: Int, x: Int, y: Int) {
    tag_square(g, x, y, 22, 0xd8902a);
    let cx = x + 11;
    let cy = y + 11;
    if k == 0 {
        disc(g, cx, cy, 6, 0x5a6070);
        disc(g, cx, cy, 5, 0xd8e0e8);
        disc(g, cx - 2, cy - 2, 1, 0xffffff);
    } else if k == 1 {
        rect(g, cx - 5, cy - 6, 11, 7, 0x5ae0ff);
        let mut r = 0;
        while r < 6 {
            rect(g, cx - 5 + r, cy + 1 + r, 11 - r * 2, 1, 0x5ae0ff);
            r = r + 1;
        }
        rect(g, cx - 3, cy - 4, 2, 4, 0xffffff);
    } else if k == 2 {
        disc(g, cx, cy, 7, 0x6a4026);
        disc(g, cx, cy, 6, 0x8c5a36);
        rect(g, cx - 5, cy - 2, 11, 1, 0x6a4026);
        rect(g, cx - 5, cy + 1, 11, 1, 0x6a4026);
        text_mid(g, "+", cx + 1, cy - 4, 1, 0xffffff);
    } else {
        rect(g, cx - 5, cy - 4, 11, 11, 0xe8dcc0);
        rect(g, cx - 4, cy - 6, 9, 3, 0xc8b898);
        rect(g, cx - 3, cy - 1, 7, 4, 0x5aa040);
        put(g, cx, cy - 2, 0x7ad85a);
    }
}
