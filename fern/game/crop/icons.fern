// The pictures of the tools and the farm's improvements, for the shed and
// the market: pixel art written as text, 16 x 16, on a tag of the tool's
// rarity (green common, blue uncommon, purple rare). They're made once,
// when the game starts (see `icons`), and drawn from then on.

use super::gfx::*;
use super::tools::*;

pub fn tool_color(t: Int) -> Int {
    let r = tool_rarity(t);
    if r == 2 { 0xa860d8 } else if r == 1 { 0x4a90d8 } else { 0x62b052 }
}

// the colors the pictures are written in, by letter
fn keys() -> String { "kwgGsrRoyYbBteEluUcpvnmh" }
fn colors() -> List<Int> {
    [0x2a1a10, 0xfff8ec, 0x9aa0a8, 0x5a6068, 0xd8e0e8, 0xe0442e, 0x8a2a20, 0xf08a2a, 0xf8d040, 0xc89820,
     0x9a6234, 0x5a3a1a, 0xe0b878, 0x5ab04a, 0x2e7a34, 0xa0e070, 0x4a8ae0, 0x2a4a90, 0x9ae0f8, 0xf8a0c0,
     0x9a5ad0, 0x1a1a24, 0xf4e4c0, 0xfff0a0]
}

fn art(t: Int) -> List<String> {
