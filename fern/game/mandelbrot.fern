// The Mandelbrot set: the points c of the plane where z -> z^2 + c, from
// z = 0, stays near 0 forever. Outside it, a point's color says how fast
// it got away.
//
// Click to zoom in there; X zooms out, the arrows move, C changes the
// colors, R starts over. It's drawn a little each frame, roughly first,
// so it never stops answering. There are no floats: numbers are in
// 2^26ths, which goes about two million times in before the pixels are as
// small as the numbers can tell apart.

mod screen;
mod draw;

use screen::*;
use draw::{Canvas, canvas, fill_rect, show, text, text_width};

fn width() -> Int { 160 }
fn height() -> Int { 120 }
fn bits() -> Int { 26 }
fn one() -> Int { 1 << bits() }

// where the view is: its middle, how far apart pixels are, and the
// drawing's progress (the block size, then the row it's on)
struct View { x: Int, y: Int, step: Int, block: Int, row: Int, zoom: Int }

fn home() -> View {
    View { x: -one() * 3 / 4, y: 0, step: one() * 3 / width(), block: 8, row: 0, zoom: 0 }
}

fn main() {
    if !screen_open(width(), height(), 5, "fern mandelbrot") {
        panic("couldn't open a window\n");
    }
    let c = canvas(width(), height());
    let mut view = home();
    let mut palette = 0;
    let mut colors = make_palette(palette);
    loop {
        view = controls(view);
        if key_pressed(key("c")) {
            palette = (palette + 1) % 3;
            colors = make_palette(palette);
            view = again(view);
        }
        // draw for up to 12 ms of the frame
        let until = screen_ticks() + 12;
        while view.block > 0 && screen_ticks() < until {
            view = draw_row(c, view, colors);
        }
        let info = "ZOOM 2^" ++ view.zoom.show() ++ "  " ++ iterations(view).show() ++ " STEPS";
        if view.block > 0 {
            fill_rect(c, 0, height() - 7, text_width(info, 1) + 4, 7, rgb(0, 0, 0));
            text(c, info, 2, height() - 6, 1, rgb(200, 200, 200));
        }
        if !show(c) || key_pressed(key_escape()) {
            break;
        }
    }
}

// the view after this frame's keys and clicks
fn controls(v: View) -> View with Io {
    let pan = v.step * 8;
    if mouse_clicked() {
        // zoom in twice as far, around where the click was
        let x = v.x + (mouse_x() - width() / 2) * v.step;
        let y = v.y + (mouse_y() - height() / 2) * v.step;
        if v.step > 8 {
            again(View { x: x, y: y, step: v.step / 2, block: 8, row: 0, zoom: v.zoom + 1 })
        } else {
            v
        }
    } else if key_pressed(key("x")) && v.zoom > 0 {
        again(View { x: v.x, y: v.y, step: v.step * 2, block: 8, row: 0, zoom: v.zoom - 1 })
    } else if key_pressed(key("r")) {
        home()
    } else if key_down(key_left()) {
        again(View { x: v.x - pan, y: v.y, step: v.step, block: 8, row: 0, zoom: v.zoom })
    } else if key_down(key_right()) {
        again(View { x: v.x + pan, y: v.y, step: v.step, block: 8, row: 0, zoom: v.zoom })
    } else if key_down(key_up()) {
        again(View { x: v.x, y: v.y - pan, step: v.step, block: 8, row: 0, zoom: v.zoom })
    } else if key_down(key_down_arrow()) {
        again(View { x: v.x, y: v.y + pan, step: v.step, block: 8, row: 0, zoom: v.zoom })
    } else {
        v
    }
}

// the same view, drawn again from the start
fn again(v: View) -> View {
    View { x: v.x, y: v.y, step: v.step, block: 8, row: 0, zoom: v.zoom }
}

// how many steps before a point counts as in the set: more, further in
fn iterations(v: View) -> Int { 96 + v.zoom * 24 }

// one row of blocks: each block the color of its top left pixel. Blocks of
// 8 first, then 4, 2, and single pixels (skipping those a bigger block
// already worked out).
fn draw_row(c: Canvas, v: View, colors: Array<Int>) -> View {
    let b = v.block;
    let limit = iterations(v);
    let mut x = 0;
    while x < width() {
        // (on later rounds, a pixel at the corner of the last round's block is done)
        let done = b < 8 && x % (b * 2) == 0 && v.row % (b * 2) == 0;
        if !done {
            let n = escape(v.x + (x - width() / 2) * v.step, v.y + (v.row - height() / 2) * v.step, limit);
            let color = if n >= limit { rgb(0, 0, 0) } else { array_get(colors, n * 3 % 256) };
            fill_rect(c, x, v.row, b, b, color);
        }
        x = x + b;
    }
    let row = v.row + b;
    if row < height() {
        View { x: v.x, y: v.y, step: v.step, block: b, row: row, zoom: v.zoom }
    } else {
        View { x: v.x, y: v.y, step: v.step, block: b / 2, row: 0, zoom: v.zoom }
    }
}

// how many steps of z -> z^2 + c until |z| > 2 (or limit, if it doesn't)
fn escape(cx: Int, cy: Int, limit: Int) -> Int {
    let mut zx = 0;
    let mut zy = 0;
    let mut n = 0;
    let four = 4 << bits();
    loop {
        let xx = zx * zx >> bits();
        let yy = zy * zy >> bits();
        if xx + yy > four || n >= limit {
            break;
        }
        zy = (zx * zy >> (bits() - 1)) + cy;
        zx = xx - yy + cx;
        n = n + 1;
    }
    n
}

// 256 colors, smoothly from one to the next around a loop of a few
fn make_palette(which: Int) -> Array<Int> {
    let stops = match which {
        0 => [rgb(0, 7, 100), rgb(32, 107, 203), rgb(237, 255, 255), rgb(255, 170, 0), rgb(120, 20, 0)],
        1 => [rgb(20, 0, 40), rgb(140, 20, 120), rgb(255, 120, 60), rgb(255, 240, 150), rgb(40, 160, 140)],
        _ => [rgb(5, 20, 5), rgb(40, 120, 40), rgb(200, 255, 140), rgb(250, 250, 250), rgb(60, 60, 90)],
    };
    let colors = array(256, 0);
    let n = stops.len();
    let mut i = 0;
    while i < 256 {
        let at = i * n;
        let a = nth(stops, at / 256);
        let b = nth(stops, (at / 256 + 1) % n);
        let t = at % 256;
        array_set(colors, i, blend(a, b, t));
        i = i + 1;
    }
    colors
}

fn nth(xs: List<Int>, i: Int) -> Int {
    match xs {
        Nil => 0,
        Cons(x, rest) => if i == 0 { x } else { nth(rest, i - 1) },
    }
}

// from a (t = 0) to b (t = 256)
fn blend(a: Int, b: Int, t: Int) -> Int {
    let mix = |sh: Int| ((a >> sh & 255) * (256 - t) + (b >> sh & 255) * t) / 256;
    rgb(mix(16), mix(8), mix(0))
}
