// ---- the night

pub struct Run {
    w: World,
    still: Still,
    // each brazier: lit (1) or not (0), and how near to catching it is
    lit: Array<Int>,
    heat: Array<Int>,
    // what the light that stays was last worked out with
    baked: Array<Int>,
    foes: Foes,
    shots: Pool, bolts: Pool, drops: Pool, sparks: Pool, nums: Pool,
    fires: Pool, rings: Pool, zaps: Pool, flashes: Pool,
    v: Array<Int>,
    // what the player has: each upgrade's level (0 if not), each weapon's
    // cooldown, whether it's evolved, and the damage it's done
    lv: Array<Int>,
    cd: Array<Int>,
    evo: Array<Int>,
    dealt: Array<Int>,
    stat: Array<Int>,
    table: Array<Int>,
    dice: Array<Int>,
    // the creatures by where they are, a cell of 16 pixels each: the
    // first in each cell, and the next after each
    head: Array<Int>,
    next: Array<Int>,
    near: Array<Int>,
    // the way to the player from each tile (8 pixels) near: a direction
    // (0 east, then round clockwise by eighths), or -1
    pass: Array<Int>,
    way: Array<Int>,
    dist: Array<Int>,
    queue: Array<Int>,
    // sounds to play: what, a number for it, and where (pan), three cells each
    sounds: Array<Int>,
    banner: Array<String>,
    // the hearth's upgrades, bought between nights (see save.fern)
    meta: Array<Int>,
}

