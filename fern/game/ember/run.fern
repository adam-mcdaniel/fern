// A night: everything in it, and the bookkeeping the rest shares.
//
// What there are many of (creatures, shots, embers on the ground, sparks)
// is kept in pools: a column (an array) for each of their numbers, a row
// for each one, the rows in use packed at the front. A row is added at the
// end, and the dead are swept out at the end of each frame, the last row
// moving into each one's place. Positions are in 16ths of a pixel.
//
// The night's own numbers (where the player is, how hurt, the time) are
// cells of one array, `v`, each with a name: get(r, k_hp()).

use crate::math::{rng, random, sines, isqrt};
use super::world::{World, size, cells, blocks, brazier_count, occ_at};
use super::light::{Still, still};

// ---- pools

pub struct Pool { cols: Array<Array<Int>>, n: Array<Int>, cap: Int }

pub fn pool(fields: Int, cap: Int) -> Pool {
    let cols = array(fields, array(0, 0));
    let mut i = 0;
    while i < fields {
        array_set(cols, i, array(cap, 0));
        i = i + 1;
    }
    Pool { cols: cols, n: array(1, 0), cap: cap }
}

pub fn count(p: Pool) -> Int { array_get(p.n, 0) }
pub fn col(p: Pool, f: Int) -> Array<Int> { array_get(p.cols, f) }
pub fn clear(p: Pool) { array_set(p.n, 0, 0) }

// a new row, all zeros: its index, or -1 if the pool is full
pub fn spawn(p: Pool) -> Int {
    let i = count(p);
    if i >= p.cap { -1 } else {
        let mut f = 0;
        while f < array_length(p.cols) {
            array_set(array_get(p.cols, f), i, 0);
            f = f + 1;
        }
        array_set(p.n, 0, i + 1);
        i
    }
}

// the rows whose column `alive` is no longer above 0, gone
pub fn sweep(p: Pool, alive: Int) {
    let a = col(p, alive);
    let fields = array_length(p.cols);
    let mut n = count(p);
    let mut i = 0;
    while i < n {
        if array_get(a, i) <= 0 {
            n = n - 1;
            if i < n {
                let mut f = 0;
                while f < fields {
                    let c = array_get(p.cols, f);
                    array_set(c, i, array_get(c, n));
                    f = f + 1;
                }
            }
        } else {
            i = i + 1;
        }
    }
    array_set(p.n, 0, n);
}

// ---- the creatures

pub struct Foes {
    p: Pool,
    x: Array<Int>, y: Array<Int>,
    // knocked back: how fast, in 16ths of a pixel a frame
    vx: Array<Int>, vy: Array<Int>,
    hp: Array<Int>, max: Array<Int>, kind: Array<Int>,
    // frames left of looking hit
    flash: Array<Int>,
    // a timer, and what it's doing (each kind its own)
    t: Array<Int>, state: Array<Int>,
    elite: Array<Int>,
    // frames until the halo, a fire or the beam can hurt it again
    halo: Array<Int>, burn: Array<Int>, beam: Array<Int>,
    // the last nova to hit it
    ring: Array<Int>,
    speed: Array<Int>, dmg: Array<Int>, r: Array<Int>, xp: Array<Int>,
    // where it's headed (an angle, a brazier, ...)
    aim: Array<Int>,
    id: Array<Int>,
}

pub fn foes(cap: Int) -> Foes {
    let p = pool(21, cap);
    Foes {
        p: p, x: col(p, 0), y: col(p, 1), vx: col(p, 2), vy: col(p, 3), hp: col(p, 4), max: col(p, 5),
        kind: col(p, 6), flash: col(p, 7), t: col(p, 8), state: col(p, 9), elite: col(p, 10),
        halo: col(p, 11), burn: col(p, 12), beam: col(p, 13), ring: col(p, 14), speed: col(p, 15),
        dmg: col(p, 16), r: col(p, 17), xp: col(p, 18), aim: col(p, 19), id: col(p, 20),
    }
}

