pub fn get(r: Run, k: Int) -> Int { array_get(r.v, k) }
pub fn keep(r: Run, k: Int, x: Int) { array_set(r.v, k, x) }
pub fn inc(r: Run, k: Int, d: Int) { array_set(r.v, k, array_get(r.v, k) + d) }

// the player's stats: percentages (100 is as it starts), or amounts
pub fn st_might() -> Int { 0 }
pub fn st_area() -> Int { 1 }
pub fn st_speed() -> Int { 2 }
pub fn st_haste() -> Int { 3 }
pub fn st_magnet() -> Int { 4 }
pub fn st_maxhp() -> Int { 5 }
pub fn st_regen() -> Int { 6 }
pub fn st_armor() -> Int { 7 }
pub fn st_amount() -> Int { 8 }
pub fn st_greed() -> Int { 9 }
pub fn st_light() -> Int { 10 }
pub fn st_choices() -> Int { 11 }

pub fn stat(r: Run, s: Int) -> Int { array_get(r.stat, s) }

pub fn grid() -> Int { 96 }
pub fn tiles() -> Int { 192 }

pub fn new_run(w: World, region: Int, character: Int, meta: Array<Int>, seed: Int) -> Run {
    let foes_cap = 900;
    let r = Run {
        w: w,
        still: still(),
        lit: array(brazier_count(w), 0),
        heat: array(brazier_count(w), 0),
        baked: array(brazier_count(w), -1),
        foes: foes(foes_cap),
        shots: pool(11, 500), bolts: pool(6, 300), drops: pool(6, 900), sparks: pool(8, 2400), nums: pool(5, 80),
        fires: pool(6, 80), rings: pool(7, 16), zaps: pool(6, 160), flashes: pool(7, 64),
        v: array(64, 0),
        lv: array(14, 0),
        cd: array(8, 0),
        evo: array(8, 0),
        dealt: array(8, 0),
        stat: array(16, 0),
        table: sines(),
        dice: rng(seed),
        head: array(grid() * grid(), -1),
        next: array(foes_cap, -1),
        near: array(1024, 0),
        pass: array(tiles() * tiles(), 0),
        way: array(tiles() * tiles(), -1),
        dist: array(tiles() * tiles(), -1),
        queue: array(tiles() * tiles(), 0),
        sounds: array(3 * 64, 0),
        banner: array(1, ""),
        meta: meta,
    };
    keep(r, k_x(), w.start_x * 16);
    keep(r, k_y(), w.start_y * 16);
    keep(r, k_level(), 1);
    keep(r, k_region(), region);
    keep(r, k_char(), character);
    keep(r, k_boss(), -1);
    keep(r, k_seed(), seed);
    keep(r, k_face(), 768);
    // (the first brazier, the one in the middle, burns already)
    array_set(r.lit, 0, 1);
    // which tiles can be walked through
    let mut ty = 0;
    while ty < tiles() {
        let mut tx = 0;
        while tx < tiles() {
            let free = occ_at(w, tx * 8 + 1, ty * 8 + 1) < blocks() && occ_at(w, tx * 8 + 6, ty * 8 + 1) < blocks()
                && occ_at(w, tx * 8 + 1, ty * 8 + 6) < blocks() && occ_at(w, tx * 8 + 6, ty * 8 + 6) < blocks();
            array_set(r.pass, ty * tiles() + tx, if free { 1 } else { 0 });
            tx = tx + 1;
        }
        ty = ty + 1;
    }
    r
}

pub fn roll(r: Run, n: Int) -> Int { random(r.dice, n.max(1)) }

// a sound to play this frame, heard from where it is (x in 16ths of a pixel)
pub fn sound(r: Run, what: Int, n: Int, x: Int) {
    let k = get(r, k_nsounds());
    if k < 64 {
        array_set(r.sounds, k * 3, what);
        array_set(r.sounds, k * 3 + 1, n);
        let pan = ((x - get(r, k_x())) / 16 * 100 / 260).clamp(-90, 90);
        array_set(r.sounds, k * 3 + 2, pan);
        keep(r, k_nsounds(), k + 1);
    }
}

pub fn announce(r: Run, s: String) {
    array_set(r.banner, 0, s);
    keep(r, k_banner_t(), 210);
}

pub fn minute(r: Run) -> Int { get(r, k_time()) / 3600 }

// ---- where the creatures are

// each creature put in its cell
pub fn sort_foes(r: Run) {
    let f = r.foes;
    let n = count(f.p);
    let g = grid();
    let mut i = 0;
    while i < g * g {
        array_set(r.head, i, -1);
        i = i + 1;
    }
    i = 0;
    while i < n {
        let c = ((array_get(f.y, i) >> 8).clamp(0, g - 1)) * g + (array_get(f.x, i) >> 8).clamp(0, g - 1);
        array_set(r.next, i, array_get(r.head, c));
        array_set(r.head, c, i);
        i = i + 1;
    }
}

// the creatures (still alive) whose middles are within `range` pixels of
// (x, y) (in 16ths), into r.near; how many
pub fn nearby(r: Run, x: Int, y: Int, range: Int) -> Int {
    let f = r.foes;
    let g = grid();
    let (px, py) = (x >> 4, y >> 4);
    let reach = range + 24;
    let cx0 = ((px - reach) >> 4).max(0);
    let cx1 = ((px + reach) >> 4).min(g - 1);
    let cy1 = ((py + reach) >> 4).min(g - 1);
    let r2 = range * range * 256;
    let mut found = 0;
    let mut cy = ((py - reach) >> 4).max(0);
    while cy <= cy1 {
        let mut cx = cx0;
        while cx <= cx1 {
            let mut i = array_get(r.head, cy * g + cx);
            while i >= 0 {
                let dx = array_get(f.x, i) - x;
                let dy = array_get(f.y, i) - y;
                if dx * dx + dy * dy <= r2 && array_get(f.hp, i) > 0 && found < 1024 {
                    array_set(r.near, found, i);
                    found = found + 1;
                }
                i = array_get(r.next, i);
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    found
}

// the nearest creature to (x, y) within range pixels, or -1
pub fn nearest(r: Run, x: Int, y: Int, range: Int) -> Int {
    let n = nearby(r, x, y, range);
    let f = r.foes;
    let mut best = -1;
    let mut best_d = 1 << 60;
    let mut i = 0;
    while i < n {
        let j = array_get(r.near, i);
        let dx = array_get(f.x, j) - x;
        let dy = array_get(f.y, j) - y;
        if dx * dx + dy * dy < best_d {
            best_d = dx * dx + dy * dy;
            best = j;
        }
        i = i + 1;
    }
    best
}

// ---- the way to the player

pub fn dir_x(d: Int) -> Int { if d == 0 { 256 } else if d == 1 || d == 7 { 181 } else if d == 3 || d == 5 { -181 } else if d == 4 { -256 } else { 0 } }
pub fn dir_y(d: Int) -> Int { if d == 2 { 256 } else if d == 1 || d == 3 { 181 } else if d == 5 || d == 7 { -181 } else if d == 6 { -256 } else { 0 } }

// a breadth-first search out from the player's tile, as far as 72 tiles:
// each tile it reaches is told the way back, the opposite of the way the
// search came into it. (Not diagonally past a corner.)
pub fn find_ways(r: Run) {
    let t = tiles();
    let n = t * t;
    let mut i = 0;
    while i < n {
        array_set(r.dist, i, -1);
        array_set(r.way, i, -1);
        i = i + 1;
    }
    let start = ((get(r, k_y()) >> 7).clamp(0, t - 1)) * t + (get(r, k_x()) >> 7).clamp(0, t - 1);
    array_set(r.dist, start, 0);
    array_set(r.queue, 0, start);
    let mut head = 0;
    let mut tail = 1;
    while head < tail {
        let c = array_get(r.queue, head);
        head = head + 1;
        let d = array_get(r.dist, c);
        if d < 72 {
            let (cx, cy) = (c % t, c / t);
            let mut k = 0;
            while k < 8 {
                let dx = if k == 0 || k == 1 || k == 7 { 1 } else if k >= 3 && k <= 5 { -1 } else { 0 };
                let dy = if k >= 1 && k <= 3 { 1 } else if k >= 5 { -1 } else { 0 };
                let (nx, ny) = (cx + dx, cy + dy);
                if nx >= 0 && ny >= 0 && nx < t && ny < t {
                    let nb = ny * t + nx;
                    let corner_ok = dx == 0 || dy == 0 || (array_get(r.pass, cy * t + nx) == 1 && array_get(r.pass, ny * t + cx) == 1);
                    if array_get(r.dist, nb) < 0 && array_get(r.pass, nb) == 1 && corner_ok {
                        array_set(r.dist, nb, d + 1);
                        array_set(r.way, nb, (k + 4) % 8);
                        array_set(r.queue, tail, nb);
                        tail = tail + 1;
                    }
                }
                k = k + 1;
            }
        }
    }
}

// the way toward the player from (x, y) (16ths): a direction, or -1
pub fn way_at(r: Run, x: Int, y: Int) -> Int {
    let t = tiles();
    let (tx, ty) = (x >> 7, y >> 7);
    if tx < 0 || ty < 0 || tx >= t || ty >= t { -1 } else { array_get(r.way, ty * t + tx) }
}

// a length, near enough: the longer side and a bit of the shorter (for
// pushing creatures apart, where a square root each would cost too much)
pub fn length(dx: Int, dy: Int) -> Int {
    let (a, b) = (dx.abs(), dy.abs());
    if a > b { a + b * 3 / 8 } else { b + a * 3 / 8 }
}

pub fn dist(dx: Int, dy: Int) -> Int { isqrt(dx * dx + dy * dy) }

// whether a pixel (in 16ths) is somewhere a walker can be
pub fn walkable16(r: Run, x: Int, y: Int) -> Bool { occ_at(r.w, x >> 4, y >> 4) < blocks() }

// whether a point (16ths) is in the land, inside its edge
pub fn inside(x: Int, y: Int) -> Bool { x > 48 * 16 && y > 48 * 16 && x < (size() - 48) * 16 && y < (size() - 48) * 16 }
