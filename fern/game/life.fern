// Conway's Game of Life: a cell with 3 live neighbours comes alive, one
// with 2 or 3 stays alive, and the rest die. Cells get bluer as they age,
// and leave a fading trail when they die.
//
// Draw with the mouse; space pauses (and S steps while paused), R fills
// the board at random, G puts down a glider gun, C clears.

mod screen;
mod draw;

use screen::*;
use draw::{Canvas, canvas, show, fill_rect, text, text_width};

fn width() -> Int { 160 }
fn height() -> Int { 120 }

// A cell is its age if it's alive (1 up), else minus how long it's been
// dead, down to -24 (long dead, or never alive), for its trail.
fn alive(cell: Int) -> Bool { cell > 0 }

fn main() {
    if !screen_open(width(), height(), 5, "fern life") {
        panic("couldn't open a window\n");
    }
    let c = canvas(width(), height());
    let mut now = array(width() * height(), -24);
    let mut next = array(width() * height(), -24);
    let rng = array(1, screen_ticks());
    soup(now, rng);
    gun(now, 10, 10);
    let mut paused = false;
    let mut generation = 0;
    loop {
        if key_pressed(key_space()) { paused = !paused }
        if key_pressed(key("r")) { soup(now, rng) }
        if key_pressed(key("c")) { wipe(now) }
        if key_pressed(key("g")) { gun(now, mouse_x() - 18, mouse_y() - 4) }
        if mouse_down() {
            let mut d = -1;
            while d <= 1 {
                set(now, mouse_x() + d, mouse_y(), 1);
                set(now, mouse_x(), mouse_y() + d, 1);
                d = d + 1;
            }
        }
        if !paused || key_pressed(key("s")) {
            step(now, next);
            // (the new board is the next one, and the old one is room for the one after)
            let t = now;
            now = next;
            next = t;
            generation = generation + 1;
        }
        paint(c, now);
        let label = if paused { "PAUSED " ++ generation.show() } else { generation.show() };
        fill_rect(c, 0, 0, text_width(label, 1) + 4, 8, rgb(0, 0, 0));
        text(c, label, 2, 2, 1, rgb(200, 200, 210));
        if !show(c) || key_pressed(key_escape()) {
            break;
        }
    }
}

// the generation after `now`, into `next` (the edges wrap around)
fn step(now: Array<Int>, next: Array<Int>) {
    let mut y = 0;
    while y < height() {
        let up = (y + height() - 1) % height() * width();
        let here = y * width();
        let down = (y + 1) % height() * width();
        let mut x = 0;
        while x < width() {
            let l = (x + width() - 1) % width();
            let r = (x + 1) % width();
            let n = count(now, up + l) + count(now, up + x) + count(now, up + r)
                + count(now, here + l) + count(now, here + r)
                + count(now, down + l) + count(now, down + x) + count(now, down + r);
            let cell = array_get(now, here + x);
            let after = if alive(cell) {
                if n == 2 || n == 3 { (cell + 1).min(200) } else { -1 }
            } else if n == 3 {
                1
            } else {
                (cell - 1).max(-24)
            };
            array_set(next, here + x, after);
            x = x + 1;
        }
        y = y + 1;
    }
}

fn count(cells: Array<Int>, i: Int) -> Int {
    if array_get(cells, i) > 0 { 1 } else { 0 }
}

fn set(cells: Array<Int>, x: Int, y: Int, v: Int) {
    if x >= 0 && y >= 0 && x < width() && y < height() { array_set(cells, y * width() + x, v) }
}

// about one cell in four alive
fn soup(cells: Array<Int>, rng: Array<Int>) {
    let mut i = 0;
    while i < width() * height() {
        let s = array_get(rng, 0) * 1103515245 + 12345 & 0x7fffffff;
        array_set(rng, 0, s);
        array_set(cells, i, if (s >> 16) % 4 == 0 { 1 } else { -24 });
        i = i + 1;
    }
}

fn wipe(cells: Array<Int>) {
    let mut i = 0;
    while i < width() * height() {
        array_set(cells, i, -24);
        i = i + 1;
    }
}

// Gosper's glider gun, which makes a glider every 30 generations, with its
// top left at (x, y)
fn gun(cells: Array<Int>, x: Int, y: Int) {
    let rows = ["........................O...........",
                "......................O.O...........",
                "............OO......OO............OO",
                "...........O...O....OO............OO",
                "OO........O.....O...OO..............",
                "OO........O...O.OO....O.O...........",
                "..........O.....O.......O...........",
                "...........O...O....................",
                "............OO......................"];
    pattern(cells, x, y, rows);
}

fn pattern(cells: Array<Int>, x: Int, y: Int, rows: List<String>) {
    match rows {
        Nil => (),
        Cons(row, rest) => {
            let mut i = 0;
            while i < string_length(row) {
                set(cells, x + i, y, if char_at(row, i) == char_at("O", 0) { 1 } else { -24 });
                i = i + 1;
            }
            pattern(cells, x, y + 1, rest);
        }
    }
}

fn paint(c: Canvas, cells: Array<Int>) {
    let mut i = 0;
    while i < width() * height() {
        let cell = array_get(cells, i);
        let color = if cell > 0 {
            // white when born, to blue when old
            let age = cell.min(60);
            rgb(255 - age * 3, 255 - age * 2, 255)
        } else {
            // the trail: purple, fading out
            let t = 24 + cell;
            rgb(10 + t * 3, 10 + t, 20 + t * 3)
        };
        array_set(c.pixels, i, color);
        i = i + 1;
    }
}
