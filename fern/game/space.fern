// Drawing space in 3D: a camera that turns around a point (and how a point
// looks from it), light added to the framebuffer (so glows overlap
// brighter), and trails that fade.

use crate::draw::{Canvas, line};
use crate::math::{sin, cos};
use crate::gravity::{Fx, V3};

// looking at `center` from `distance` away, turned by yaw (about the up
// axis, y) and pitch, in 1024ths of a turn; `focal` is how far the screen
// is from the eye, in pixels: the field of view. (`table`: math.fern's sines.)
pub struct View { center: V3, yaw: Int, pitch: Int, distance: Fx, focal: Fx, table: Array<Int> }

// where p is on canvas c, and how far it is from the eye, if it's in front
pub fn project(c: Canvas, v: View, p: V3) -> Option<(Int, Int, Fx)> {
    let q = p - v.center;
    let (cy, sy) = (Fx::from16(cos(v.table, v.yaw)), Fx::from16(sin(v.table, v.yaw)));
    let (cp, sp) = (Fx::from16(cos(v.table, v.pitch)), Fx::from16(sin(v.table, v.pitch)));
    let x = q.x * cy - q.z * sy;
    let z = q.x * sy + q.z * cy;
    let y = q.y * cp - z * sp;
    let depth = q.y * sp + z * cp + v.distance;
    if depth < Fx::ratio(1, 4) {
        None
    } else {
        let k = v.focal / depth;
        Some(((x * k).round() + c.width / 2, c.height / 2 - (y * k).round(), depth))
    }
}

// how many pixels across `size` looks at `depth`
pub fn apparent(v: View, size: Fx, depth: Fx) -> Int {
    (size * v.focal / depth).round()
}

// adds light of color (r, g, b), times amount / 256, to pixel (x, y)
pub fn shine(c: Canvas, x: Int, y: Int, r: Int, g: Int, b: Int, amount: Int) {
    if x >= 0 && y >= 0 && x < c.width && y < c.height {
        let i = y * c.width + x;
        let p = array_get(c.pixels, i);
        let nr = ((p >> 16 & 255) + r * amount / 256).min(255);
        let ng = ((p >> 8 & 255) + g * amount / 256).min(255);
        let nb = ((p & 255) + b * amount / 256).min(255);
        array_set(c.pixels, i, nr * 65536 + ng * 256 + nb);
    }
}

// a point of light with a glow around it
pub fn spark(c: Canvas, x: Int, y: Int, r: Int, g: Int, b: Int, amount: Int) {
    shine(c, x, y, r, g, b, amount);
    let glow = amount / 3;
    shine(c, x - 1, y, r, g, b, glow);
    shine(c, x + 1, y, r, g, b, glow);
    shine(c, x, y - 1, r, g, b, glow);
    shine(c, x, y + 1, r, g, b, glow);
}

// a ball of light `radius` pixels across at (x, y): brightest in the
// middle, fading to its edge, and a faint halo past it
pub fn ball(c: Canvas, x: Int, y: Int, radius: Int, r: Int, g: Int, b: Int) {
    let rr = radius.max(1);
    let outer = rr + rr / 2 + 1;
    let mut dy = -outer;
    while dy <= outer {
        let mut dx = -outer;
        while dx <= outer {
            let d2 = dx * dx + dy * dy;
            if d2 <= rr * rr {
                shine(c, x + dx, y + dy, r, g, b, 160 + 96 * (rr * rr - d2) / (rr * rr));
            } else if d2 <= outer * outer {
                shine(c, x + dx, y + dy, r, g, b, 40 * (outer * outer - d2) / (outer * outer - rr * rr));
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

// a line between two points in space, if both are in front
pub fn line3(c: Canvas, v: View, a: V3, b: V3, color: Int) {
    match (project(c, v, a), project(c, v, b)) {
        (Some((x0, y0, _)), Some((x1, y1, _))) => line(c, x0, y0, x1, y1, color),
        _ => {}
    }
}

// the last frame dimmed, by a quarter (`keep` 3) or a half (`keep` 1), so
// what moves leaves a trail; or (`keep` 0) cleared
pub fn fade(c: Canvas, keep: Int) {
    let n = c.width * c.height;
    let mut i = 0;
    if keep == 3 {
        while i < n {
            let p = array_get(c.pixels, i);
            // (each channel less a quarter of itself, all at once)
            array_set(c.pixels, i, p - (p >> 2 & 0x3f3f3f));
            i = i + 1;
        }
    } else if keep == 1 {
        while i < n {
            let p = array_get(c.pixels, i);
            array_set(c.pixels, i, p >> 1 & 0x7f7f7f);
            i = i + 1;
        }
    } else {
        while i < n {
            array_set(c.pixels, i, 0);
            i = i + 1;
        }
    }
}
