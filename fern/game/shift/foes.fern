// The bloom's creatures: what comes when (the shift's director), how each
// kind moves and fights, and the thing at the heart of it, which comes at
// the end.
//
// Walkers follow the way the search from the robot found (run::find_ways)
// round machinery and walls, and push each other apart so a crowd spreads;
// drifters and stalkers float straight over everything.

use crate::math::{sin, cos, isqrt};
use super::run::*;
use super::arms::*;
use super::world::{relay_count, size};
use super::gfx::{rgb};

// ---- the kinds' numbers

// hit points, speed (16ths of a pixel a frame), damage, scrap, radius
fn base_hp(k: Int) -> Int { if k == 0 { 9 } else if k == 1 { 6 } else if k == 2 { 40 } else if k == 3 { 5 } else if k == 4 { 22 } else if k == 5 { 30 } else { 75 } }
fn base_speed(k: Int) -> Int { if k == 0 { 9 } else if k == 1 { 17 } else if k == 2 { 6 } else if k == 3 { 26 } else if k == 4 { 8 } else if k == 5 { 11 } else { 12 } }
fn base_dmg(k: Int) -> Int { if k == 0 { 5 } else if k == 1 { 4 } else if k == 2 { 10 } else if k == 3 { 4 } else if k == 4 { 6 } else if k == 5 { 6 } else { 14 } }
fn base_xp(k: Int) -> Int { if k == 0 || k == 1 || k == 3 { 1 } else if k == 2 || k == 4 { 3 } else if k == 5 { 4 } else { 6 } }
fn base_r(k: Int) -> Int { if k == 2 { 8 } else if k == 6 { 7 } else if k == 4 || k == 5 { 6 } else { 5 } }

pub fn boss_name(region: Int) -> String {
    if region == 0 { "THE OVERGROWTH" } else if region == 1 { "PATIENT ZERO" } else { "THE BLOOM HEART" }
}

pub fn boss_minute() -> Int { 9 }

// a creature of a kind at (x, y) (16ths): its index, or -1
pub fn add_foe(r: Run, kind: Int, x: Int, y: Int, elite: Bool) -> Int {
    let f = r.foes;
    let i = spawn(f.p);
    if i >= 0 {
        let m = minute(r);
        let region = r.region;
        let toughness = 100 + m * 22 + region * 35 + (if m >= 8 { (m - 7) * 30 } else { 0 });
        let hp = if kind == boss() { (if region == 0 { 2600 } else if region == 1 { 4400 } else { 7200 }) }
            else { base_hp(kind) * toughness / 100 * (if elite { 14 } else { 1 }) };
        f.x.set(i, x);
        f.y.set(i, y);
        f.hp.set(i, hp);
        f.max.set(i, hp);
        f.kind.set(i, kind);
        f.elite.set(i, if elite { 1 } else { 0 });
        f.speed.set(i, if kind == boss() { 7 } else { base_speed(kind) * (95 + roll(r, 12)) / 100 + region });
        f.dmg.set(i, if kind == boss() { 22 + region * 6 } else { base_dmg(kind) * (100 + m * 9 + region * 20) / 100 * (if elite { 2 } else { 1 }) });
        f.r.set(i, if kind == boss() { 22 } else if elite { base_r(kind) * 3 / 2 + 3 } else { base_r(kind) });
        f.xp.set(i, if kind == boss() { 0 } else { base_xp(kind) * (if elite { 12 } else { 1 }) });
        f.t.set(i, roll(r, 200));
        f.aim.set(i, -1);
        f.ring.set(i, -1);
        r.ids = r.ids + 1;
        f.id.set(i, r.ids);
    }
    i
}

// somewhere for a creature to come from: just out of sight round the
// player, where a walker can stand (or nowhere, (-1, -1))
fn edge_spot(r: Run, flies: Bool) -> (Int, Int) {
    let mut tries = 0;
    let mut found = (-1, -1);
    while tries < 8 {
        let a = roll(r, 1024);
        let d = 290 + roll(r, 50);
        let x = r.x + cos(r.table, a) * d / 4096;
        let y = r.y + sin(r.table, a) * d / 4096;
        if inside(x, y) && (flies || walkable16(r, x, y)) {
            found = (x, y);
            tries = 8;
        }
        tries = tries + 1;
    }
    found
}

// ---- the director

// what comes, minute by minute: a kind picked by the minute's weights
fn pick_kind(r: Run) -> Int {
    let m = minute(r).min(8);
    let w = if m == 0 { [100, 0, 0, 0, 0, 0, 0] } else if m == 1 { [80, 20, 0, 0, 0, 0, 0] } else if m == 2 { [60, 25, 15, 0, 0, 0, 0] }
        else if m == 3 { [45, 25, 20, 0, 10, 0, 0] } else if m == 4 { [35, 25, 20, 0, 10, 10, 0] } else if m == 5 { [30, 20, 24, 0, 12, 8, 6] }
        else if m == 6 { [26, 20, 22, 0, 12, 8, 12] } else { [22, 20, 22, 0, 12, 8, 16] };
    let mut pick = roll(r, 100);
    let mut k = 0;
    let mut chosen = 0;
    let mut rest = w;
    let mut done = false;
    loop {
        match rest {
            Nil => { break; }
            Cons(x, tail) => {
                if !done && pick < x { chosen = k; done = true } else if !done { pick = pick - x }
                k = k + 1;
                rest = tail;
            }
        }
    }
    chosen
}

pub fn direct(r: Run) {
    let t = r.time;
    let m = minute(r);
    let region = r.region;
    let alive = count(r.foes.p);
    let boss_up = r.boss >= 0;
    // the steady stream: more, and more often, as the shift goes on
    let every = (84 - m * 9 - region * 6).max(6);
    let most = (110 + m * 55 + region * 40).min(r.foes.p.cap - 60);
    let crowd = if boss_up { most / 3 } else { most };
    if t % every == 0 && alive < crowd {
        let n = 1 + (m + region) / 2 + (if m > 0 { roll(r, 2) } else { 0 });
        let mut k = 0;
        while k < n {
            let kind = pick_kind(r);
            let (x, y) = edge_spot(r, kind == stalker());
            if x >= 0 { add_foe(r, kind, x, y, false); }
            k = k + 1;
        }
    }
    // the shift's events, at their times (seconds)
    let s = t / 60;
    if t % 60 == 0 && !boss_up {
        if s == 30 { announce(r, "THEY'RE COMING. GET THE RELAYS BACK ONLINE.") }
        if s == 80 || s == 250 || s == 440 { swarm(r, if s > 200 { 2 } else { 1 }) }
        if s == 150 || s == 300 || s == 390 || s == 470 { elite(r) }
        if s == 180 { encircle(r, sporeling(), 44) }
        if s == 360 { encircle(r, bloater(), 28) }
        if s == 270 { pack(r, chewer(), 6); announce(r, "CHEWERS! THEY'LL CUT THE RELAYS' POWER.") }
        if s == 500 { announce(r, "THE BLOOM IS SPREADING...") }
        if s == boss_minute() * 60 { summon_boss(r) }
    }
}

// a cloud of drifters, straight across the screen, from one side (or two)
fn swarm(r: Run, sides: Int) {
    let mut side = 0;
    while side < sides {
        let a = roll(r, 1024);
        let (dx, dy) = (cos(r.table, a), sin(r.table, a));
        let (cx, cy) = (r.x - dx * 300 / 4096, r.y - dy * 300 / 4096);
        let mut k = 0;
        while k < 26 {
            // (a block of them, side by side and a few deep)
            let across = (k % 9 - 4) * 18;
            let back = (k / 9) * 20;
            let x = cx - dy * across / 4096 - dx * back / 4096;
            let y = cy + dx * across / 4096 - dy * back / 4096;
            let i = add_foe(r, drifter(), x, y, false);
            if i >= 0 { r.foes.aim.set(i, a) }
            k = k + 1;
        }
        side = side + 1;
    }
    announce(r, "DRIFTERS!");
    sound(r, s_alarm(), 0, r.x);
}

fn encircle(r: Run, kind: Int, n: Int) {
    let mut k = 0;
    while k < n {
        let a = k * 1024 / n;
        let x = r.x + cos(r.table, a) * 230 / 4096;
        let y = r.y + sin(r.table, a) * 160 / 4096;
        if inside(x, y) && walkable16(r, x, y) { add_foe(r, kind, x, y, false); }
        k = k + 1;
    }
    announce(r, "SURROUNDED!");
    sound(r, s_alarm(), 0, r.x);
}

fn pack(r: Run, kind: Int, n: Int) {
    let (x, y) = edge_spot(r, false);
    if x >= 0 {
        let mut k = 0;
        while k < n {
            add_foe(r, kind, x + (roll(r, 40) - 20) * 16, y + (roll(r, 40) - 20) * 16, false);
            k = k + 1;
        }
    }
}

fn elite(r: Run) {
    let m = minute(r);
    let kind = if m < 4 { bloater() } else if m < 6 { spitter() } else { stalker() };
    let (x, y) = edge_spot(r, kind == stalker());
    if x >= 0 {
        add_foe(r, kind, x, y, true);
        announce(r, "SOMETHING BIG IS COMING...");
        sound(r, s_alarm(), 1, x);
    }
}

fn summon_boss(r: Run) {
    let (x, y) = edge_spot(r, true);
    let (bx, by) = if x >= 0 { (x, y) } else { (r.x, r.y - 250 * 16) };
    let i = add_foe(r, boss(), bx, by, false);
    if i >= 0 {
        r.boss = r.foes.id.get(i);
        announce(r, boss_name(r.region));
        sound(r, s_roar(), 0, bx);
        shake(r, 10);
    }
}

// ---- each creature, each frame

pub fn move_foes(r: Run) {
    let f = r.foes;
    let n = count(f.p);
    let (px, py) = (r.x, r.y);
    let g = grid();
    let mut i = 0;
    while i < n {
        let kind = f.kind.get(i);
        let (x, y) = (f.x.get(i), f.y.get(i));
        let t = f.t.get(i) + 1;
        f.t.set(i, t);
        f.flash.set(i, (f.flash.get(i) - 1).max(0));
        f.drone.set(i, (f.drone.get(i) - 1).max(0));
        f.wet.set(i, (f.wet.get(i) - 1).max(0));
        f.beam.set(i, (f.beam.get(i) - 1).max(0));
        let speed = f.speed.get(i);
        let radius = f.r.get(i);
        // where it wants to go, as a direction 256 long
        let (wx, wy) = if kind == boss() { boss_think(r, i) }
            else if kind == drifter() {
                let a = f.aim.get(i);
                if t > 900 { f.hp.set(i, 0) }
                ((cos(r.table, a) >> 8), (sin(r.table, a) >> 8))
            }
            else if kind == spitter() { spitter_think(r, i) }
            else if kind == chewer() { chewer_think(r, i) }
            else { toward_player(r, x, y, kind == stalker()) };
        // pushed apart from those it's crowding (its cell and the ones round it)
        let mut sx = 0;
        let mut sy = 0;
        if kind != drifter() {
            let (cx, cy) = ((x >> 8).clamp(0, g - 1), (y >> 8).clamp(0, g - 1));
            let mut oy = (cy - 1).max(0);
            while oy <= (cy + 1).min(g - 1) {
                let mut ox = (cx - 1).max(0);
                while ox <= (cx + 1).min(g - 1) {
                    let mut j = r.head.get(oy * g + ox);
                    while j >= 0 {
                        if j != i {
                            let dx = x - f.x.get(j);
                            let dy = y - f.y.get(j);
                            let want = (radius + f.r.get(j)) * 16;
                            if dx.abs() < want && dy.abs() < want {
                                let d = length(dx, dy);
                                if d < want {
                                    let push = (want - d) / 3;
                                    let dd = d.max(1);
                                    sx = sx + dx * push / dd;
                                    sy = sy + dy * push / dd;
                                }
                            }
                        }
                        j = r.next.get(j);
                    }
                    ox = ox + 1;
                }
                oy = oy + 1;
            }
        }
        let vx = f.vx.get(i);
        let vy = f.vy.get(i);
        f.vx.set(i, vx * 13 / 16);
        f.vy.set(i, vy * 13 / 16);
        // (slowed wading through water or slush)
        let wading = kind != drifter() && kind != stalker() && kind != boss() && super::world::occ_at(r.w, x >> 4, y >> 4) == super::world::slow();
        let sp = if wading { speed / 2 } else { speed };
        let mx = (wx * sp >> 8) + sx.clamp(-24, 24) + vx;
        let my = (wy * sp >> 8) + sy.clamp(-24, 24) + vy;
        let flies = kind == drifter() || kind == stalker() || kind == boss();
        let nx = x + mx;
        let ny = y + my;
        if flies {
            if inside(nx, ny) || kind == drifter() {
                f.x.set(i, nx);
                f.y.set(i, ny);
            }
        } else {
            if walkable16(r, nx, y) { f.x.set(i, nx) }
            if walkable16(r, f.x.get(i), ny) { f.y.set(i, ny) }
        }
        // too far behind: brought round to the front again
        let (fx, fy) = (f.x.get(i) - px, f.y.get(i) - py);
        if kind != boss() && kind != drifter() && (fx.abs() > 520 * 16 || fy.abs() > 400 * 16) {
            let (ex, ey) = edge_spot(r, flies);
            if ex >= 0 {
                f.x.set(i, ex);
                f.y.set(i, ey);
            }
        }
        i = i + 1;
    }
}

// toward the player: by the way found round things, or straight if
// there's none (too far, or flying)
fn toward_player(r: Run, x: Int, y: Int, straight: Bool) -> (Int, Int) {
    let d = if straight { -1 } else { way_at(r, x, y) };
    let (dx, dy) = (r.x - x, r.y - y);
    // (close enough: straight at it)
    if d < 0 || (dx.abs() < 160 && dy.abs() < 160) { unit(dx, dy) } else { (dir_x(d), dir_y(d)) }
}

// a spitter keeps its distance, and spits
fn spitter_think(r: Run, i: Int) -> (Int, Int) {
    let f = r.foes;
    let (x, y) = (f.x.get(i), f.y.get(i));
    let (dx, dy) = (r.x - x, r.y - y);
    let d = dist(dx, dy) / 16;
    let t = f.t.get(i);
    if t % 150 == 0 && d < 220 {
        let (ux, uy) = unit(dx, dy);
        let n = if f.elite.get(i) > 0 { 5 } else { 1 };
        let mut k = 0;
        while k < n {
            let a = (k * 2 - (n - 1)) * 30;
            let (c, s) = (cos(r.table, a), sin(r.table, a));
            bolt(r, x, y, ((ux * c - uy * s) >> 16) * 22 / 256, ((ux * s + uy * c) >> 16) * 22 / 256, f.dmg.get(i));
            k = k + 1;
        }
        sound(r, s_spit(), 0, x);
    }
    if d < 100 { let (ux, uy) = unit(-dx, -dy); (ux, uy) } else if d > 150 { toward_player(r, x, y, false) } else { (0, 0) }
}

// a chewer goes for the nearest relay that's on, and cuts its power
fn chewer_think(r: Run, i: Int) -> (Int, Int) {
    let f = r.foes;
    let (x, y) = (f.x.get(i), f.y.get(i));
    let mut best = -1;
    let mut best_d = 600 * 600;
    let mut b = 0;
    while b < relay_count(r.w) {
        if r.lit.get(b) > 0 {
            let dx = r.w.relays.get(b * 2) - x / 16;
            let dy = r.w.relays.get(b * 2 + 1) - y / 16;
            if dx * dx + dy * dy < best_d {
                best_d = dx * dx + dy * dy;
                best = b;
            }
        }
        b = b + 1;
    }
    if best < 0 { toward_player(r, x, y, false) } else {
        let (bx, by) = (r.w.relays.get(best * 2) * 16, r.w.relays.get(best * 2 + 1) * 16);
        if best_d < 18 * 18 {
            // (beside it: chewing through the cables, which takes two seconds)
            let s = f.state.get(i) + 1;
            f.state.set(i, s);
            if s > 120 {
                r.lit.set(best, 0);
                r.heat.set(best, 0);
                f.state.set(i, 0);
                sound(r, s_cut(), 0, x);
                announce(r, "A RELAY HAS GONE DOWN.");
            }
            (0, 0)
        } else {
            f.state.set(i, 0);
            unit(bx - x, by - y)
        }
    }
}

// ---- the creatures' shots

pub fn bolt(r: Run, x: Int, y: Int, vx: Int, vy: Int, dmg: Int) {
    let p = r.bolts;
    let i = spawn(p);
    if i >= 0 {
        col(p, bo_x()).set(i, x);
        col(p, bo_y()).set(i, y);
        col(p, bo_vx()).set(i, vx);
        col(p, bo_vy()).set(i, vy);
        col(p, bo_life()).set(i, 300);
        col(p, bo_dmg()).set(i, dmg);
    }
}

// bolts flying: they stop at walls, and hurt the player
pub fn move_bolts(r: Run) -> Int {
    let p = r.bolts;
    let n = count(p);
    let (px, py) = (r.x, r.y);
    let mut hit = 0;
    let mut i = 0;
    while i < n {
        let x = col(p, bo_x()).get(i) + col(p, bo_vx()).get(i);
        let y = col(p, bo_y()).get(i) + col(p, bo_vy()).get(i);
        col(p, bo_x()).set(i, x);
        col(p, bo_y()).set(i, y);
        let life = col(p, bo_life()).get(i) - 1;
        col(p, bo_life()).set(i, life);
        if super::world::occ_at(r.w, x >> 4, y >> 4) == super::world::walls() { col(p, bo_life()).set(i, 0) }
        let (dx, dy) = (x - px, y - py);
        if dx * dx + dy * dy < 7 * 7 * 256 {
            hit = hit.max(col(p, bo_dmg()).get(i));
            col(p, bo_life()).set(i, 0);
            burst(r, x, y, 8, rgb(200, 100, 255), 40, 14);
        }
        i = i + 1;
    }
    sweep(p, bo_life());
    hit
}

// ---- the boss

// what the boss does next, by turns: coming at the robot a while, then
// one of its region's attacks
fn boss_think(r: Run, i: Int) -> (Int, Int) {
    let f = r.foes;
    let (x, y) = (f.x.get(i), f.y.get(i));
    let region = r.region;
    let t = f.t.get(i);
    let state = f.state.get(i);
    let enraged = f.hp.get(i) * 3 < f.max.get(i);
    let walk_for = if enraged { 110 } else { 170 };
    if state == 0 {
        if t > walk_for {
            // (the next attack, round its region's list)
            let turn = f.aim.get(i) + 1;
            f.aim.set(i, turn);
            let attacks = if region == 0 { [4, 1, 3, 1] } else if region == 1 { [2, 4, 1, 2] } else { [5, 2, 3, 4, 1] };
            let next = attacks.get(turn % attacks.len()).unwrap_or(1);
            f.state.set(i, next);
            f.t.set(i, 0);
            if next == 3 { sound(r, s_roar(), 1, x) }
        }
        toward_player(r, x, y, true)
    } else if state == 1 {
        // a burst: rings of bolts all round, three times
        if t == 10 || t == 40 || t == 70 {
            let n = 22 + region * 4;
            let mut k = 0;
            while k < n {
                let a = k * 1024 / n + t * 7;
                bolt(r, x, y, (cos(r.table, a) * 20) >> 16, (sin(r.table, a) * 20) >> 16, f.dmg.get(i) / 2);
                k = k + 1;
            }
            sound(r, s_spit(), 1, x);
            flash(r, x, y, 70, 14, 0, 200);
        }
        if t > 90 { end_attack(r, i) }
        (0, 0)
    } else if state == 2 {
        // a spiral: bolts thrown round as it turns
        if t % 4 == 0 {
            let a = t * 23;
            let mut k = 0;
            while k < 3 {
                let b = a + k * 341;
                bolt(r, x, y, (cos(r.table, b) * 17) >> 16, (sin(r.table, b) * 17) >> 16, f.dmg.get(i) / 2);
                k = k + 1;
            }
        }
        if t % 20 == 0 { sound(r, s_spit(), 0, x) }
        if t > 140 { end_attack(r, i) }
        (0, 0)
    } else if state == 3 {
        // a charge: still a moment (it glows), then hurtling at where the player was
        if t < 45 {
            let (ux, uy) = unit(r.x - x, r.y - y);
            f.vx.set(i, 0);
            f.vy.set(i, 0);
            // (which way, packed into its ring cell until it goes: the
            // shockwaves' numbers there are far smaller)
            f.ring.set(i, (ux + 512) * 1024 + (uy + 512));
            (0, 0)
        } else if t < 95 {
            let packed = f.ring.get(i);
            let (ux, uy) = (packed / 1024 - 512, packed % 1024 - 512);
            if t % 3 == 0 { burst(r, x, y, 3, rgb(255, 80, 60), 30, 14) }
            (ux * 9, uy * 9)
        } else {
            end_attack(r, i);
            (0, 0)
        }
    } else if state == 4 {
        // calling its creatures to it
        if t == 20 {
            let mut k = 0;
            let n = 14;
            while k < n {
                let a = k * 1024 / n;
                let kind = if region == 0 { sporeling() } else if region == 1 { flicker() } else { stalker() };
                add_foe(r, kind, x + cos(r.table, a) * 60 / 4096, y + sin(r.table, a) * 60 / 4096, false);
                k = k + 1;
            }
            sound(r, s_roar(), 0, x);
        }
        if t > 60 { end_attack(r, i) }
        (0, 0)
    } else {
        // a blackout: it drinks the power out of the lights for a while
        if t == 10 {
            r.dark = 420;
            announce(r, "THE LIGHTS ARE FAILING!");
            sound(r, s_roar(), 1, x);
        }
        if t > 50 { end_attack(r, i) }
        (0, 0)
    }
}

fn end_attack(r: Run, i: Int) {
    r.foes.state.set(i, 0);
    r.foes.t.set(i, 0);
    r.foes.ring.set(i, -1);
}
