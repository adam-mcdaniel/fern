// ---- the shift

pub struct Run {
    w: World,
    still: Still,
    // each relay: lit (1) or not (0), and how near to catching it is
    lit: Array<Int>,
    heat: Array<Int>,
    // what the light that stays was last worked out with
    baked: Array<Int>,
    foes: Foes,
    shots: Pool, bolts: Pool, drops: Pool, sparks: Pool, nums: Pool,
    puddles: Pool, rings: Pool, zaps: Pool, flashes: Pool,
    // the robot: where (16ths of a pixel), its integrity (16ths), frames
    // it can't be hurt for and has looked hurt for, which way it faces
    // (1024ths of a turn), which way it last moved (256 long), whether it's
    // moving, and the self-repair and the relays' repair counting up
    x: Int, y: Int, hp: Int, iframes: Int, hurt: Int, face: Int,
    mvx: Int, mvy: Int, moving: Int, regen: Int, heal_t: Int,
    // how it's doing: scrap toward the next level, the level, levels and
    // crates still to open, frames gone, creatures cleared, credits found,
    // whether the backup cell has been used, whether it's down, and whether
    // the boss is dead
    xp: Int, level: Int, ups: Int, crates: Int, time: Int, frame: Int,
    kills: Int, credits: Int, revives: Int, dead: Int, won: Int,
    // the camera (pixels, and 16ths between frames), its shake, and frames
    // the action is frozen for (a hit landing)
    camx: Int, camy: Int, camfx: Int, camfy: Int, shake: Int, freeze: Int,
    // the drones' and lasers' angles, and the last shockwave's number
    drones: Int, beam: Int, shock: Int,
    // the creatures' numbers so far, the boss's (-1 before it comes),
    // frames left of its blackout, and how far the power's come back
    ids: Int, boss: Int, dark: Int, power: Int,
    // where, and who: the region and the robot
    region: Int, char: Int,
    // scrap gathered in a run, and when the last of it was
    chain: Int, chain_t: Int,
    // the sounds asked for this frame, and the banner and its frames left
    nsounds: Int, banner: String, banner_t: Int,
    // what the robot has: each upgrade's level (0 if not), each weapon's
    // cooldown, whether it's evolved, and the damage it's done
    lv: Array<Int>,
    cd: Array<Int>,
    evo: Array<Int>,
    dealt: Array<Int>,
    stat: Array<Int>,
    table: Array<Int>,
    dice: Array<Int>,
    // the creatures by where they are, a cell of 16 pixels each: the
    // first in each cell, and the next after each
    head: Array<Int>,
    next: Array<Int>,
    near: Array<Int>,
    // the way to the player from each tile (8 pixels) near: a direction
    // (0 east, then round clockwise by eighths), or -1
    pass: Array<Int>,
    way: Array<Int>,
    dist: Array<Int>,
    queue: Array<Int>,
    // which search last reached each tile, and how many there have been
    seen: Array<Int>,
    searches: Int,
    // sounds to play: what, a number for it, and where (pan), three cells each
    sounds: Array<Int>,
    // the workshop's upgrades, bought between shifts (see save.fern)
    meta: Array<Int>,
}

// the player's stats: percentages (100 is as it starts), or amounts
pub fn st_might() -> Int { 0 }
pub fn st_area() -> Int { 1 }
pub fn st_speed() -> Int { 2 }
pub fn st_haste() -> Int { 3 }
pub fn st_magnet() -> Int { 4 }
pub fn st_maxhp() -> Int { 5 }
pub fn st_regen() -> Int { 6 }
pub fn st_armor() -> Int { 7 }
pub fn st_amount() -> Int { 8 }
pub fn st_greed() -> Int { 9 }
pub fn st_light() -> Int { 10 }
pub fn st_choices() -> Int { 11 }

pub fn stat(r: Run, s: Int) -> Int { r.stat.get(s) }

pub fn grid() -> Int { 96 }
pub fn tiles() -> Int { 192 }

pub fn new_run(w: World, region: Int, character: Int, meta: Array<Int>, seed: Int) -> Run {
    let foes_cap = 900;
    let r = Run {
        w: w,
        still: still(),
        lit: array(relay_count(w), 0),
        heat: array(relay_count(w), 0),
        baked: array(relay_count(w), -1),
        foes: foes(foes_cap),
        shots: pool(11, 500), bolts: pool(6, 300), drops: pool(6, 900), sparks: pool(8, 2400), nums: pool(5, 80),
        puddles: pool(6, 80), rings: pool(7, 16), zaps: pool(6, 160), flashes: pool(7, 64),
        x: w.start_x * 16, y: w.start_y * 16, hp: 0, iframes: 0, hurt: 0, face: 768,
        mvx: 0, mvy: 0, moving: 0, regen: 0, heal_t: 0,
        xp: 0, level: 1, ups: 0, crates: 0, time: 0, frame: 0,
        kills: 0, credits: 0, revives: 0, dead: 0, won: 0,
        camx: 0, camy: 0, camfx: 0, camfy: 0, shake: 0, freeze: 0,
        drones: 0, beam: 0, shock: 0,
        ids: 0, boss: -1, dark: 0, power: 0,
        region: region, char: character,
        chain: 0, chain_t: 0,
        nsounds: 0, banner: "", banner_t: 0,
        lv: array(14, 0),
        cd: array(8, 0),
        evo: array(8, 0),
        dealt: array(8, 0),
        stat: array(16, 0),
        table: sines(),
        dice: rng(seed),
        head: array(grid() * grid(), -1),
        next: array(foes_cap, -1),
        near: array(1024, 0),
        pass: array(tiles() * tiles(), 0),
        way: array(tiles() * tiles(), -1),
        dist: array(tiles() * tiles(), -1),
        queue: array(tiles() * tiles(), 0),
        seen: array(tiles() * tiles(), 0),
        searches: 0,
        sounds: array(3 * 64, 0),
        meta: meta,
    };
    // (the first relay, the one in the middle, is on already)
    r.lit.set(0, 1);
    // which tiles can be walked through
    let mut ty = 0;
    while ty < tiles() {
        let mut tx = 0;
        while tx < tiles() {
            let free = occ_at(w, tx * 8 + 1, ty * 8 + 1) < blocks() && occ_at(w, tx * 8 + 6, ty * 8 + 1) < blocks()
                && occ_at(w, tx * 8 + 1, ty * 8 + 6) < blocks() && occ_at(w, tx * 8 + 6, ty * 8 + 6) < blocks();
            r.pass.set(ty * tiles() + tx, if free { 1 } else { 0 });
            tx = tx + 1;
        }
        ty = ty + 1;
    }
    r
}

pub fn roll(r: Run, n: Int) -> Int { random(r.dice, n.max(1)) }

// a sound to play this frame, heard from where it is (x in 16ths of a pixel)
pub fn sound(r: Run, what: Int, n: Int, x: Int) {
    let k = r.nsounds;
    if k < 64 {
        r.sounds.set(k * 3, what);
        r.sounds.set(k * 3 + 1, n);
        let pan = ((x - r.x) / 16 * 100 / 260).clamp(-90, 90);
        r.sounds.set(k * 3 + 2, pan);
        r.nsounds = k + 1;
    }
}

pub fn announce(r: Run, s: String) {
    r.banner = s;
    r.banner_t = 210;
}

pub fn minute(r: Run) -> Int { r.time / 3600 }

// ---- where the creatures are

// each creature put in its cell
pub fn sort_foes(r: Run) {
    let f = r.foes;
    let n = count(f.p);
    let g = grid();
    let mut i = 0;
    while i < g * g {
        r.head.set(i, -1);
        i = i + 1;
    }
    i = 0;
    while i < n {
        let c = ((f.y.get(i) >> 8).clamp(0, g - 1)) * g + (f.x.get(i) >> 8).clamp(0, g - 1);
        r.next.set(i, r.head.get(c));
        r.head.set(c, i);
        i = i + 1;
    }
}

// the creatures (still alive) whose middles are within `range` pixels of
// (x, y) (in 16ths), into r.near; how many
pub fn nearby(r: Run, x: Int, y: Int, range: Int) -> Int {
    let f = r.foes;
    let g = grid();
    let (px, py) = (x >> 4, y >> 4);
    let reach = range + 24;
    let cx0 = ((px - reach) >> 4).max(0);
    let cx1 = ((px + reach) >> 4).min(g - 1);
    let cy1 = ((py + reach) >> 4).min(g - 1);
    let r2 = range * range * 256;
    let mut found = 0;
    let mut cy = ((py - reach) >> 4).max(0);
    while cy <= cy1 {
        let mut cx = cx0;
        while cx <= cx1 {
            let mut i = r.head.get(cy * g + cx);
            while i >= 0 {
                let dx = f.x.get(i) - x;
                let dy = f.y.get(i) - y;
                if dx * dx + dy * dy <= r2 && f.hp.get(i) > 0 && found < 1024 {
                    r.near.set(found, i);
                    found = found + 1;
                }
                i = r.next.get(i);
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    found
}

// the nearest creature to (x, y) within range pixels, or -1
pub fn nearest(r: Run, x: Int, y: Int, range: Int) -> Int {
    let n = nearby(r, x, y, range);
    let f = r.foes;
    let mut best = -1;
    let mut best_d = 1 << 60;
    let mut i = 0;
    while i < n {
        let j = r.near.get(i);
        let dx = f.x.get(j) - x;
        let dy = f.y.get(j) - y;
        if dx * dx + dy * dy < best_d {
            best_d = dx * dx + dy * dy;
            best = j;
        }
        i = i + 1;
    }
    best
}

// ---- the way to the player

pub fn dir_x(d: Int) -> Int { if d == 0 { 256 } else if d == 1 || d == 7 { 181 } else if d == 3 || d == 5 { -181 } else if d == 4 { -256 } else { 0 } }
pub fn dir_y(d: Int) -> Int { if d == 2 { 256 } else if d == 1 || d == 3 { 181 } else if d == 5 || d == 7 { -181 } else if d == 6 { -256 } else { 0 } }

// a breadth-first search out from the robot's tile, as far as 56 tiles:
// each tile it reaches is told the way back, the opposite of the way the
// search came into it. (Not diagonally past a corner.) A tile's way and
// distance are this search's if it's marked with this search's number, so
// nothing needs clearing first.
pub fn find_ways(r: Run) {
    let t = tiles();
    r.searches = r.searches + 1;
    let mark = r.searches;
    let (seen, dist, way, queue, pass) = (r.seen, r.dist, r.way, r.queue, r.pass);
    let start = ((r.y >> 7).clamp(0, t - 1)) * t + (r.x >> 7).clamp(0, t - 1);
    seen.set(start, mark);
    dist.set(start, 0);
    way.set(start, -1);
    queue.set(0, start);
    let mut head = 0;
    let mut tail = 1;
    while head < tail {
        let c = queue.get(head);
        head = head + 1;
        let d = dist.get(c);
        if d < 56 {
            let (cx, cy) = (c % t, c / t);
            let mut k = 0;
            while k < 8 {
                let dx = if k == 0 || k == 1 || k == 7 { 1 } else if k >= 3 && k <= 5 { -1 } else { 0 };
                let dy = if k >= 1 && k <= 3 { 1 } else if k >= 5 { -1 } else { 0 };
                let nx = cx + dx;
                let ny = cy + dy;
                if nx >= 0 && ny >= 0 && nx < t && ny < t {
                    let nb = ny * t + nx;
                    if seen.get(nb) != mark && pass.get(nb) == 1 && (dx == 0 || dy == 0 || (pass.get(cy * t + nx) == 1 && pass.get(ny * t + cx) == 1)) {
                        seen.set(nb, mark);
                        dist.set(nb, d + 1);
                        way.set(nb, (k + 4) % 8);
                        queue.set(tail, nb);
                        tail = tail + 1;
                    }
                }
                k = k + 1;
            }
        }
    }
}

// the way toward the player from (x, y) (16ths): a direction, or -1
pub fn way_at(r: Run, x: Int, y: Int) -> Int {
    let t = tiles();
    let (tx, ty) = (x >> 7, y >> 7);
    if tx < 0 || ty < 0 || tx >= t || ty >= t || r.seen.get(ty * t + tx) != r.searches { -1 } else { r.way.get(ty * t + tx) }
}

// a length, near enough: the longer side and a bit of the shorter (for
// pushing creatures apart, where a square root each would cost too much)
pub fn length(dx: Int, dy: Int) -> Int {
    let (a, b) = (dx.abs(), dy.abs());
    if a > b { a + b * 3 / 8 } else { b + a * 3 / 8 }
}

pub fn dist(dx: Int, dy: Int) -> Int { isqrt(dx * dx + dy * dy) }

// whether a pixel (in 16ths) is somewhere a walker can be
pub fn walkable16(r: Run, x: Int, y: Int) -> Bool { occ_at(r.w, x >> 4, y >> 4) < blocks() }

// whether a point (16ths) is on the deck, inside its edge
pub fn inside(x: Int, y: Int) -> Bool { x > 48 * 16 && y > 48 * 16 && x < (size() - 48) * 16 && y < (size() - 48) * 16 }
