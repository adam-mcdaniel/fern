// A shift: everything in it, and the bookkeeping the rest shares.
//
// What there are many of (creatures, shots, scrap on the floor, sparks)
// is kept in pools: a column (an array) for each of their numbers, a row
// for each one, the rows in use packed at the front. A row is added at the
// end, and the dead are swept out at the end of each frame, the last row
// moving into each one's place. Positions are in 16ths of a pixel.
//
// The shift's own numbers (where the robot is, how hurt, the time) are
// the Run's fields, set as it goes: r.hp = r.hp - 16.

use crate::math::{rng, random, sines, isqrt};
use super::world::{World, size, cells, blocks, relay_count, occ_at};
use super::light::{Still, still};

// ---- pools

// (its columns, how many rows are in use, and how many there can be)
pub struct Pool { cols: Array<Array<Int>>, n: Int, cap: Int }

pub fn pool(fields: Int, cap: Int) -> Pool {
    let cols = array(fields, array(0, 0));
    let mut i = 0;
    while i < fields {
        cols.set(i, array(cap, 0));
        i = i + 1;
    }
    Pool { cols: cols, n: 0, cap: cap }
}

pub fn count(p: Pool) -> Int { p.n }
pub fn col(p: Pool, f: Int) -> Array<Int> { p.cols.get(f) }
pub fn clear(p: Pool) { p.n = 0 }

// a new row, all zeros: its index, or -1 if the pool is full
pub fn spawn(p: Pool) -> Int {
    let i = count(p);
    if i >= p.cap { -1 } else {
        let mut f = 0;
        while f < p.cols.len() {
            p.cols.get(f).set(i, 0);
            f = f + 1;
        }
        p.n = i + 1;
        i
    }
}

// the rows whose column `alive` is no longer above 0, gone
pub fn sweep(p: Pool, alive: Int) {
    let a = col(p, alive);
    let fields = p.cols.len();
    let mut n = count(p);
    let mut i = 0;
    while i < n {
        if a.get(i) <= 0 {
            n = n - 1;
            if i < n {
                let mut f = 0;
                while f < fields {
                    let c = p.cols.get(f);
                    c.set(i, c.get(n));
                    f = f + 1;
                }
            }
        } else {
            i = i + 1;
        }
    }
    p.n = n;
}

// ---- the creatures

pub struct Foes {
    p: Pool,
    x: Array<Int>, y: Array<Int>,
    // knocked back: how fast, in 16ths of a pixel a frame
    vx: Array<Int>, vy: Array<Int>,
    hp: Array<Int>, max: Array<Int>, kind: Array<Int>,
    // frames left of looking hit
    flash: Array<Int>,
    // a timer, and what it's doing (each kind its own)
    t: Array<Int>, state: Array<Int>,
    elite: Array<Int>,
    // frames until the drones, a puddle or the laser can hurt it again
    drone: Array<Int>, wet: Array<Int>, beam: Array<Int>,
    // the last shockwave to hit it
    ring: Array<Int>,
    speed: Array<Int>, dmg: Array<Int>, r: Array<Int>, xp: Array<Int>,
    // where it's headed (an angle, a relay, ...)
    aim: Array<Int>,
    id: Array<Int>,
}

pub fn foes(cap: Int) -> Foes {
    let p = pool(21, cap);
    Foes {
        p: p, x: col(p, 0), y: col(p, 1), vx: col(p, 2), vy: col(p, 3), hp: col(p, 4), max: col(p, 5),
        kind: col(p, 6), flash: col(p, 7), t: col(p, 8), state: col(p, 9), elite: col(p, 10),
        drone: col(p, 11), wet: col(p, 12), beam: col(p, 13), ring: col(p, 14), speed: col(p, 15),
        dmg: col(p, 16), r: col(p, 17), xp: col(p, 18), aim: col(p, 19), id: col(p, 20),
    }
}

