// The upgrades' icons: each drawn in a 16 x 16 square (times `s`), from
// pixel art written as text and from lines and discs, some of them moving.
// They sit on a dark square, so they're drawn bright, lit from the top
// left, in the station's cold colors with an accent each.

use crate::math::{sin, cos};
use super::gfx::*;

// a pixel of the icon's grid: (gx, gy) in 0 to 15
fn dot(g: Gfx, x: Int, y: Int, s: Int, gx: Int, gy: Int, c: Int) {
    if gx >= 0 && gy >= 0 && gx < 16 && gy < 16 { rect(g, x + gx * s, y + gy * s, s, s, c) }
}

fn dline(g: Gfx, x: Int, y: Int, s: Int, x0: Int, y0: Int, x1: Int, y1: Int, c: Int) {
    let n = (x1 - x0).abs().max((y1 - y0).abs()).max(1);
    let mut i = 0;
    while i <= n {
        dot(g, x, y, s, x0 + (x1 - x0) * i / n, y0 + (y1 - y0) * i / n, c);
        i = i + 1;
    }
}

fn ddisc(g: Gfx, x: Int, y: Int, s: Int, cx: Int, cy: Int, r: Int, c: Int) {
    let mut dy = -r;
    while dy <= r {
        let mut dx = -r;
        while dx <= r {
            if dx * dx + dy * dy <= r * r + r { dot(g, x, y, s, cx + dx, cy + dy, c) }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

fn dring(g: Gfx, x: Int, y: Int, s: Int, cx: Int, cy: Int, r: Int, c: Int) {
    let mut dy = -r - 1;
    while dy <= r + 1 {
        let mut dx = -r - 1;
        while dx <= r + 1 {
            let d = dx * dx + dy * dy;
            if d <= r * r + r && d > (r - 1) * (r - 1) + (r - 1) { dot(g, x, y, s, cx + dx, cy + dy, c) }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
}

// rows of an icon written as text: each character the color at the same
// place in `colors` as it is in `keys`, and anything else nothing
fn art(g: Gfx, x: Int, y: Int, s: Int, rows: List<String>, keys: String, colors: List<Int>) {
    let table = Array::from_list(colors, 0);
    let mut gy = 0;
    rows.each(|row| {
        let mut gx = 0;
        while gx < row.len() {
            let ch = row.char_at(gx);
            let mut k = 0;
            while k < keys.len() {
                if keys.char_at(k) == ch { dot(g, x, y, s, gx, gy, table.get(k)) }
                k = k + 1;
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    });
}

// (a point at distance d (in 16ths of a cell) from (cx, cy), at angle a)
fn at_x(t: Array<Int>, cx: Int, a: Int, d: Int) -> Int { cx + ((cos(t, a) * d + (8 << 16)) >> 20) }
fn at_y(t: Array<Int>, cy: Int, a: Int, d: Int) -> Int { cy + ((sin(t, a) * d + (8 << 16)) >> 20) }

pub fn icon(g: Gfx, u: Int, x: Int, y: Int, s: Int, frame: Int, t: Array<Int>) {
    if u == 0 {
        // the rivet gun: a riveter, side on, yellow grip, a rivet flying
        art(g, x, y, s, ["", "", "", "",
            ".wwwwwwwww",
            "mmmmmmmmmmm",
            "mmmmmmmmmmmd",
            "ddddddddddddc.rr",
            "dddddyyddddd",
            "....yyYd.d",
            "....yyY.dd",
            "...yyY",
            "...yyY",
            "...YYY"], "wmdcryY", [0xffffff, 0xa8b8c6, 0x5a6878, 0x90f8ff, 0xfff8e0, 0xf4c838, 0x9a7418]);
        if frame / 6 % 2 == 0 { dot(g, x, y, s, 13, 6, 0x4090a8); dot(g, x, y, s, 13, 8, 0x4090a8) }
    } else if u == 1 {
        // sentry drones: three, circling a hub, a light on each
        dring(g, x, y, s, 8, 8, 6, 0x163038);
        ddisc(g, x, y, s, 8, 8, 1, 0x4a5a66);
        dot(g, x, y, s, 8, 8, 0x80ffff);
        let mut k = 0;
        while k < 3 {
            let a = frame * 4 + k * 341;
            let (ox, oy) = (at_x(t, 8, a, 96), at_y(t, 8, a, 96));
            ddisc(g, x, y, s, ox, oy, 1, 0xb8c4cc);
            dot(g, x, y, s, ox - 1, oy - 1, 0xffffff);
            dot(g, x, y, s, ox, oy, 0x50f0ff);
            k = k + 1;
        }
    } else if u == 2 {
        // the cutting laser: an emitter, its red beam, sparks where it cuts
        dline(g, x, y, s, 7, 9, 15, 1, 0x801828);
        dline(g, x, y, s, 6, 8, 14, 0, 0x801828);
        dline(g, x, y, s, 6, 9, 14, 1, 0xff4050);
        dline(g, x, y, s, 8, 7, 13, 2, 0xffd8d8);
        art(g, x, y, s, ["", "", "", "", "", "", "", "",
            "...wm",
            "..wmmc",
            ".wmmmd",
            "wmmmdd",
            "mmmdd",
            "ddd"], "wmdc", [0xe8f0f4, 0x98a8b6, 0x4a5866, 0xff8090]);
        let sp = frame / 3 % 3;
        dot(g, x, y, s, 14, 1, 0xffffff);
        dot(g, x, y, s, 15 - sp, 3 + sp, 0xffd060);
        dot(g, x, y, s, 12 + sp / 2, 0, 0xffe8a0);
        dot(g, x, y, s, 15, 2 - sp / 2, 0xffb040);
    } else if u == 3 {
        // the shockwave: rings of charge bursting from a core
        dring(g, x, y, s, 8, 8, 7, 0x1c4c64);
        dring(g, x, y, s, 8, 8, 5, 0x3a90b8);
        let p = frame / 4 % 6;
        if p >= 2 { dring(g, x, y, s, 8, 8, p + 1, 0xc0f8ff) }
        ddisc(g, x, y, s, 8, 8, 2, 0x60d0f0);
        ddisc(g, x, y, s, 8, 8, 1, 0xe0ffff);
        // (sparks of it, arcing out)
        dot(g, x, y, s, 2, 3, 0x90e8ff);
        dot(g, x, y, s, 13, 12, 0x90e8ff);
        dot(g, x, y, s, 13, 3, 0x5ab0d8);
        dot(g, x, y, s, 3, 13, 0x5ab0d8);
    } else if u == 4 {
        // seekers: little round bots, eyes lit, swooping in on their trails
        let trail = [0x3a98b8, 0x2a7a96, 0x1e5c74, 0x154456, 0x0e2e3c];
        let mut k = 0;
        trail.each(|c| {
            dot(g, x, y, s, 8 - k * 2, 4 + (k * k) / 6, c);
            dot(g, x, y, s, 8 - k * 2, 5 + (k * k) / 6, scale(c, 160));
            dot(g, x, y, s, 4 - k, 12 - k / 2 - (k * k) / 4, scale(c, 200));
            k = k + 1;
        });
        ddisc(g, x, y, s, 11, 4, 2, 0xa8b6c0);
        dot(g, x, y, s, 10, 3, 0xffffff);
        dot(g, x, y, s, 11, 2, 0xe0e8ee);
        dot(g, x, y, s, 12, 4, if frame / 8 % 2 == 0 { 0x80ffff } else { 0x40c8e0 });
        dot(g, x, y, s, 11, 6, 0x5a6874);
        ddisc(g, x, y, s, 7, 12, 2, 0x98a6b0);
        dot(g, x, y, s, 6, 11, 0xffffff);
        dot(g, x, y, s, 8, 12, if frame / 8 % 2 == 1 { 0x80ffff } else { 0x40c8e0 });
        dot(g, x, y, s, 7, 14, 0x505c68);
    } else if u == 5 {
        // cleaner spill: a caustic green puddle, bubbling, a drop falling in
        art(g, x, y, s, ["", "", "", "", "", "", "", "", "",
            "..........lll",
            "...lllll.lmmml",
            "..lmmhhmllmmmml",
            ".lmmhmmmmmmmmmmd",
            ".dmmmmmmmmmmmmdd",
            "..ddmmmmmmmmdd",
            "....ddddddd"], "lmhd", [0x9cf070, 0x52c040, 0xe0ffc0, 0x2c7a28]);
        // (bubbles rising off it)
        let mut k = 0;
        while k < 3 {
            let rise = (frame / 5 + k * 3) % 8;
            let bx = 4 + k * 3;
            if rise < 6 { dot(g, x, y, s, bx + (rise / 2) % 2, 10 - rise, if rise < 3 { 0xb8ff90 } else { 0x60a848 }) }
            k = k + 1;
        }
        // (the drop)
        let fall = frame / 3 % 10;
        if fall < 7 {
            dot(g, x, y, s, 11, fall, 0xb8ff90);
            dot(g, x, y, s, 11, fall + 1, 0x70d050);
            dot(g, x, y, s, 10, fall + 1, 0x4a9a38);
        }
    } else if u == 6 {
        // the tesla coil: a copper-wound tower, a sphere on top, arcing
        art(g, x, y, s, ["",
            "......wmm",
            ".....wmmmd",
            ".....mmmdd",
            "......ddd",
            ".......oo",
            "......OOOO",
            ".......oo",
            "......OOOO",
            ".......oo",
            "......OOOO",
            ".......oo",
            ".....dmmmmd",
            "....dmmmmmmd",
            "....dddddddd"], "wmdoO", [0xffffff, 0xb0bec8, 0x58687a, 0xf0a050, 0x9a5a28]);
        let seed = frame / 3;
        let j = |k: Int| (seed * 7 + k * 13) % 3 - 1;
        dline(g, x, y, s, 10, 2, 12, 4 + j(1), 0xc8f4ff);
        dline(g, x, y, s, 12, 4 + j(1), 13, 7 + j(2), 0x80d0ff);
        dline(g, x, y, s, 13, 7 + j(2), 15, 8, 0x4090d0);
        dline(g, x, y, s, 5, 2, 3, 4 + j(3), 0xc8f4ff);
        dline(g, x, y, s, 3, 4 + j(3), 2, 6 + j(4), 0x80d0ff);
        dline(g, x, y, s, 2, 6 + j(4), 0, 8, 0x4090d0);
    } else if u == 7 {
        // the cargo drop: a crate coming down, its target marked below
        art(g, x, y, s, [
            "....s..s...s",
            "....s......s",
            ".......s",
            "..llllllllllll",
            "..bOOOOOOOOOOb",
            "..bykykykykykb",
            "..bOOOOOOOOOOb",
            "..bOObbbbbbOOb",
            "..bOOOOOOOOOOb",
            "..bbbbbbbbbbbb"], "slbOyk", [0x3a5260, 0xffc070, 0x6a3412, 0xe08a30, 0xf8d040, 0x2a1a10]);
        let blink = if frame / 8 % 2 == 0 { 0xff5040 } else { 0x902820 };
        art(g, x, y, s, ["", "", "", "", "", "", "", "", "", "", "", "",
            "....rr....rr",
            "...r........r",
            "....rr....rr"], "r", [blink]);
        dot(g, x, y, s, 8, 13, blink);
    } else if u == 8 {
        // the floodlight: a great round lamp in its yoke, throwing light
        dline(g, x, y, s, 2, 5, 2, 10, 0x5a6878);
        dline(g, x, y, s, 14, 5, 14, 10, 0x5a6878);
        dline(g, x, y, s, 2, 10, 4, 12, 0x5a6878);
        dline(g, x, y, s, 14, 10, 12, 12, 0x5a6878);
        dline(g, x, y, s, 8, 12, 8, 14, 0x7a8896);
        dline(g, x, y, s, 5, 15, 11, 15, 0x5a6878);
        ddisc(g, x, y, s, 8, 7, 5, 0x46546a);
        ddisc(g, x, y, s, 8, 7, 4, 0xa0b0be);
        ddisc(g, x, y, s, 8, 7, 3, 0xa8e4ff);
        ddisc(g, x, y, s, 8, 7, 2, 0xe8fbff);
        dot(g, x, y, s, 7, 6, 0xffffff);
        dot(g, x, y, s, 6, 5, 0xffffff);
        let ray = if frame / 10 % 2 == 0 { 0xe0f8ff } else { 0x80b8d0 };
        dot(g, x, y, s, 8, 0, ray);
        dot(g, x, y, s, 3, 1, ray);
        dot(g, x, y, s, 13, 1, ray);
        dot(g, x, y, s, 0, 4, ray);
        dot(g, x, y, s, 15, 4, ray);
    } else if u == 9 {
        // overclock: a chip, an arrow on it pointing up
        art(g, x, y, s, ["",
            "....p.p..p.p",
            "...kkkkkkkkkk",
            "...kgggaagggk",
            "..pkggaaaaggkp",
            "...kgaaaaaagk",
            "..pkgggAAgggkp",
            "...kgggAAgggk",
            "..pkgggAAgggkp",
            "...kgggAAgggk",
            "..pkggggggggkp",
            "...kkkkkkkkkk",
            "....p.p..p.p"], "pkgaA", [0xb8c4cc, 0x262e36, 0x3c4650, 0xff7050, 0xd84838]);
        if frame / 12 % 2 == 0 { dot(g, x, y, s, 7, 3, 0xffd0b0); dot(g, x, y, s, 8, 3, 0xffd0b0) }
    } else if u == 10 {
        // servos: a gear, turning
        let rot = frame * 2;
        let mut k = 0;
        while k < 8 {
            let a = rot + k * 128;
            ddisc(g, x, y, s, at_x(t, 8, a, 96), at_y(t, 8, a, 96), 1, 0x7a8896);
            k = k + 1;
        }
        ddisc(g, x, y, s, 8, 8, 5, 0x7a8896);
        ddisc(g, x, y, s, 8, 8, 4, 0xa8b6c2);
        dot(g, x, y, s, 6, 5, 0xe0e8f0);
        dot(g, x, y, s, 5, 6, 0xe0e8f0);
        ddisc(g, x, y, s, 8, 8, 1, 0x0c1216);
        dot(g, x, y, s, 9, 9, 0x3a4652);
    } else if u == 11 {
        // plating: an armor plate, riveted, a stripe of paint across it
        art(g, x, y, s, ["",
            "..ssssssssssss",
            "..smmmmmmmmmmd",
            "..smrmmmmmmrmd",
            "..smmmmmmmmmmd",
            "..scccccccccce",
            "..scccccccccce",
            "..smmmmmmmmmmd",
            "...smmmmmmmmd",
            "...smrmmmmrmd",
            "....smmmmmmd",
            ".....smmmmd",
            "......smmd",
            ".......dd"], "smdrce", [0xdce6ee, 0x8a9aaa, 0x46566a, 0xffffff, 0x40d0c8, 0x208078]);
    } else if u == 12 {
        // the tractor beam: a magnet, scrap flying up into it
        art(g, x, y, s, ["",
            ".....RRRRRR",
            "...RRRRRRRRRR",
            "..RRRrrrrrrRRr",
            "..RRr......RRr",
            "..RRr......RRr",
            "..RRr......RRr",
            "..www......www",
            "..ddd......ddd"], "Rrwd", [0xe84848, 0x942830, 0xf0f4f8, 0x8a96a2]);
        let mut k = 0;
        while k < 3 {
            let up = (frame / 4 + k * 2) % 6;
            dot(g, x, y, s, 3 + k * 4, 15 - up, 0x3c8aa8);
            dot(g, x, y, s, 4 + k * 3, 14 - (up + 3) % 6, if k == 1 { 0xffd040 } else { 0x80d8ff });
            k = k + 1;
        }
    } else {
        // coolant: a snowflake, six arms, each branched
        let mut k = 0;
        while k < 6 {
            let a = k * 1024 / 6 + 256;
            dline(g, x, y, s, 8, 8, at_x(t, 8, a, 104), at_y(t, 8, a, 104), 0x88d4ff);
            let (bx, by) = (at_x(t, 8, a, 64), at_y(t, 8, a, 64));
            dline(g, x, y, s, bx, by, at_x(t, bx, a + 160, 40), at_y(t, by, a + 160, 40), 0x5aa8e0);
            dline(g, x, y, s, bx, by, at_x(t, bx, a - 160, 40), at_y(t, by, a - 160, 40), 0x5aa8e0);
            dot(g, x, y, s, at_x(t, 8, a, 104), at_y(t, 8, a, 104), 0xe8f8ff);
            k = k + 1;
        }
        ddisc(g, x, y, s, 8, 8, 1, 0xc8f0ff);
        dot(g, x, y, s, 8, 8, 0xffffff);
    }
}
