// DELVE: eight floors down into the dark, to bring back the Ember Crown
// from the Warden who keeps it. Your torch is all that holds the dark back,
// and it burns down with every turn: find oil, for when it's out, you can
// hardly see, and what's in the dark strikes harder.
//
// Every step is a turn, and on each the monsters move too: they come at
// you when they see you, and strike when they're beside you. Walk into one
// to fight it. Gold, potions, oil, and better blades and armor lie about;
// what you walk over, you pick up. Kills make you stronger. Find the stairs
// down (a dark pit in the floor) on each floor.
//
// Up and down step forward and back, left and right turn, A and D step
// aside, space waits a turn, P drinks a potion, escape quits.
//
// The view is cast a column at a time: a ray from the eye across the map
// to the wall it meets, which is drawn as tall as near it is; the floor and
// ceiling a row at a time; and the monsters and things in front of the
// walls they're nearer than. All of it lit by the torch, fading to black.

mod screen;
mod draw;
mod math;

use screen::*;
use draw::{Canvas, canvas, show, text, text_width, fill_rect};
use math::{sines, sin, cos, rng, random};

fn width() -> Int { 320 }
fn height() -> Int { 200 }
// the 3D view's height (the panel is below it)
fn view() -> Int { 166 }
// the map's width and height, in tiles
fn tiles() -> Int { 32 }
fn floors() -> Int { 8 }

fn wall() -> Int { 1 }
fn open() -> Int { 0 }
fn stairs() -> Int { 2 }

// ---- pictures

// a 16 by 16 picture from rows of characters, each a color by `key` (the
// color of key's nth character is values' nth); '.' is see-through (-1)
fn picture(rows: List<String>, key: String, values: List<Int>) -> Array<Int> {
    let a = array(256, -1);
    let mut y = 0;
    rows.each(|row| {
        let mut x = 0;
        while x < 16 && x < string_length(row) {
            let ch = char_at(row, x);
            let mut k = 0;
            while k < string_length(key) {
                if char_at(key, k) == ch {
                    match values.drop(k).head() {
                        Some(v) => array_set(a, y * 16 + x, v),
                        None => {}
                    }
                }
                k = k + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    });
    a
}

