// A module in a file of its own: `import shapes` loads it as an object, and
// binds it to `shapes`. Its members are the file's definitions.

type Shape = { val name: String; def area(): Int }

def square(side: Int): Shape = new { val name = "square"; def area(): Int = side * side }

def rect(w: Int, h: Int): Shape = new { val name = "rectangle"; def area(): Int = w * h }

def describe(s: Shape): String = "a " + s.name + " of area " + s.area()
