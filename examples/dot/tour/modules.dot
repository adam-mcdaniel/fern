// Modules in DOT.
//
// DOT has no module system, because it doesn't need one: an object is a
// module. Its fields are the module's values, its type members are the
// module's types, and a record type with abstract type members is a
// signature. Everything here is written with `module`, `import` and the
// like, but each is just a way of writing an object, as the comments show.

// 1. A module is an object. `module M { ... }` is `val M = new { M => ... }`.

module Counter {
  type T = Int
  def zero(): T = 0
  def next(n: T): T = n + 1
  def show(n: T): String = "#" + n
}
println(Counter.show(Counter.next(Counter.next(Counter.zero()))))
// ... and since `Counter.T` is just `Int`, anyone can see it is:
println(Counter.next(41))

// 2. Sealing: a signature is a record type, and `module M: Sig { ... }` is
// `val M: Sig = new { ... }`. What `Sig` leaves abstract, nobody outside can
// see: `Clock.T` is an abstract type, a different type from `Int` (and from
// every other module's `T`), so a clock can only be made and used through
// the module.

type Ticker = { t =>
  type T
  def zero(): t.T
  def next(n: t.T): t.T
  def show(n: t.T): String
}

module Clock: Ticker {
  type T = Int
  def zero(): T = 0
  def next(n: T): T = (n + 1) % 12
  def show(n: T): String = (if (n == 0) 12 else n) + " o'clock"
}

def times(n: Int, t: Ticker, from: t.T): t.T = if (n == 0) from else times(n - 1, t, t.next(from))
println(Clock.show(times(15, Clock, Clock.zero())))
// `Clock.next(41)` would be a type error: 41 isn't a Clock.T.

// 3. First-class modules: a module is a value, so it can be chosen at run
// time, passed to functions (as `times` takes one above), and kept in data
// structures. Its abstract type then depends on which value it is: a path
// dependent type.

module Up: Ticker {
  type T = Int
  def zero(): T = 0
  def next(n: T): T = n + 1
  def show(n: T): String = "up " + n
}
val chosen: Ticker = if (read() > 0) Clock else Up
println(chosen.show(times(3, chosen, chosen.zero())))

// 4. Functors: a function from modules to modules. Its result's types can
// depend on its argument's: `Pairs(Clock).T` is a pair of `Clock.T`s.

def Pairs(t: Ticker): Ticker = new {
  type T = { val first: t.T; val second: t.T }
  def zero(): T = new { val first = t.zero(); val second = t.zero() }
  def next(p: T): T = new { val first = t.next(p.first); val second = t.next(t.next(p.second)) }
  def show(p: T): String = "(" + t.show(p.first) + ", " + t.show(p.second) + ")"
}
val Double = Pairs(Clock)
println(Double.show(times(7, Double, Double.zero())))

// 5. Importing: `import M._` names all of `M`'s members, and
// `import M.{a, b => c}` some of them, so they can be used without `M.`.
// It's only naming: `next` below is `Counter.next`.

import Counter.{next, show => display}
println(display(next(next(0))))

// 6. Modules in files: `import shapes` loads `shapes.dot` (from the same
// directory, or the standard library for `std.*`) as an object, once,
// however many places import it.

import shapes
import shapes.{describe, square}
println(describe(square(3)))
println(shapes.describe(shapes.rect(2, 5)))

// 7. The standard library is modules written in DOT: here a functor makes
// a module of maps for an ordering, whose `Map` type is abstract.

import std.option._
import std.map as maps
val Names = maps.sorted(maps.strings)
val ages = Names.put(Names.put(Names.put(Names.empty(), "carol", 41), "alice", 37), "bob", 23)
println(getOrElse(Names.get(ages, "bob"), 0) + getOrElse(Names.get(ages, "alice"), 0))
println(Names.size(ages))
