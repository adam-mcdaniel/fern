// Mutable state. DOT itself is pure; `var` and `while` go beyond it, with
// one rule to keep its types sound: a `var` can change, so nothing's type
// can depend on it. A var field's type can't change either (it's
// invariant), since the field can be written as well as read.

// 1. Variables and loops.
var i = 0
var total = 0
while (i < 10) {
  i = i + 1
  if (i % 2 == 0) total = total + i else ()
}
println(total)

// 2. Closures share the variables they use: each call to `next` sees what
// the last one left.
def counter(): () => Int = {
  var n = 0
  () => { n = n + 1; n }
}
val next = counter()
next(); next()
println(next())

// 3. Objects with var fields.
type Account = { var balance: Int; def deposit(n: Int): Unit }
def account(start: Int): Account = new { self =>
  var balance = start
  def deposit(n: Int): Unit = self.balance = self.balance + n
}
val acct = account(100)
acct.deposit(50)
acct.balance = acct.balance - 30
println(acct.balance)

// 4. A var field can be read as a val (that only gives up writing it)...
def peek(x: { val balance: Int }): Int = x.balance
println(peek(acct))
// ...but a type can't depend on a path through one: given
// `val box = new { var inner = new { type T = Int } }`, the type `box.inner.T`
// is rejected, since `box.inner` could be a different object later.

// 5. The standard library's cells and arrays.
import std.ref._
import std.array._
import std.list._
val r = ref("a")
update(r, s => s + "b")
update(r, s => s + "c")
println(r.value)
val squares = array(6, 0)
var k = 0
while (k < squares.length) { squares.set(k, k * k); k = k + 1 }
println(mkString(map(toList(squares), (x: Int) => "" + x), " "))
