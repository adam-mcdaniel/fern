// File I/O, through C. The `extern` functions are in io.c, which a
// native build links in:
//
//   cargo run --example dot -- examples/dot/ffi/io.dot --build io examples/dot/ffi/io.c
//
// C gets a DOT string as the address of its length and characters (dot.h
// reads it), and gives text back by filling a buffer from `std.c`.

import std.c._
import std.text._
import std.list._

extern def write_file(path: String, text: String): Bool
extern def read_file(path: String, into: Int, capacity: Int): Int
extern def env_var(name: String, into: Int, capacity: Int): Int

val path = "/tmp/dot-io-demo.txt"
if (write_file(path, "first line\nsecond line\nthird\n")) println("wrote " + path) else println("couldn't write " + path)

val buf = buffer(4096)
val n = read_file(path, buf.cells, buf.capacity)
println("read " + n + " characters")
val lines = filter(split(contents(buf), 10), (l: String) => l.length > 0)
foreach(lines, (l: String) => println("> " + upper(l)))
println(length(lines) + " lines")

val name = buffer(256)
if (env_var("DOT_DEMO", name.cells, name.capacity) < 0) println("DOT_DEMO isn't set")
else println("DOT_DEMO is " + contents(name))
