// The things code generation has to get right: evaluation order around
// calls, && and || only working out their right side when they need it, and
// loop conditions that call functions every time round.
fn bump(a) {
    a[0] = a[0] + 1;
    return 10;
}

fn noisy(x) {
    print("[", x, "]");
    return x;
}

fn below(a, n) {
    return a[0] < n;
}

fn main() {
    let a = array(1);
    a[0] = 1;
    print(a[0] + bump(a), "\n");          // 1 + 10: a[0] read before the call
    print(noisy(0) && noisy(1), "\n");    // [0]0: the right side isn't run
    print(noisy(2) || noisy(3), "\n");    // [2]1
    while below(a, 5) { a[0] = a[0] + 1; }
    print(a[0], "\n");                    // 5
    let i = 0;
    let odd = 0;
    while i < 10 {
        i = i + 1;
        if i % 2 == 0 { continue; }
        if i > 7 { break; }
        odd = odd + i;
    }
    print(odd, "\n");                     // 1 + 3 + 5 + 7 = 16
}
