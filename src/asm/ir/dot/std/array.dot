// Fixed-size mutable arrays, written in DOT on top of three of the
// compiler's built-in functions, which allocate and access raw cells.
// What's in the cells is erased, so they're generic, and trusted to give
// back what was put in.

import std.list._

builtin def mem_new(n: Int): Int
builtin def mem_get[A](cells: Int, i: Int): A
builtin def mem_set[A](cells: Int, i: Int, x: A): Unit

type Array[A] = {
  val length: Int
  def get(i: Int): A
  def set(i: Int, x: A): Unit
}

def array[A](n: Int, x: A): Array[A] = {
  val cells = mem_new(n)
  var i = 0
  while (i < n) { mem_set(cells, i, x); i = i + 1 }
  new Array[A] {
    val length = n
    def get(i: Int): A = if (i < 0 || i >= n) error("array index out of range") else mem_get[A](cells, i)
    def set(i: Int, x: A): Unit = if (i < 0 || i >= n) error("array index out of range") else mem_set(cells, i, x)
  }
}

def fromList[A](xs: List[A], fill: A): Array[A] = {
  val a = array(length(xs), fill)
  var i = 0
  foreach(xs, (x: A) => { a.set(i, x); i = i + 1 })
  a
}

def toList[A](a: Array[A]): List[A] = {
  var done = nil[A]()
  var i = a.length - 1
  while (i >= 0) { done = cons(a.get(i), done); i = i - 1 }
  done
}
