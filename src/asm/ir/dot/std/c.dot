// Talking to C. A C function (`extern def`) gets a string as the address of
// its length and characters, which `dot.h` reads; to give text back, it
// fills a buffer made here, which then reads as a string.

builtin def mem_new(n: Int): Int
builtin def mem_as_string(cells: Int): String

type Buffer = { val cells: Int; val capacity: Int }

def buffer(size: Int): Buffer = new { val cells = mem_new(size + 1); val capacity = size }

// What C has put in the buffer, as a string (which shares its cells, so it's
// only good until C fills the buffer again).
def contents(b: Buffer): String = mem_as_string(b.cells)
