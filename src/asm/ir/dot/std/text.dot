// Working with strings.

import std.option._
import std.list._

def repeat(s: String, n: Int): String = if (n <= 0) "" else s + repeat(s, n - 1)

def padLeft(s: String, width: Int): String = repeat(" ", width - s.length) + s

def split(s: String, sep: Int): List[String] = {
  def go(i: Int, start: Int, done: List[String]): List[String] =
    if (i == s.length) reverse(cons(s.substring(start, i), done))
    else if (s.charAt(i) == sep) go(i + 1, i + 1, cons(s.substring(start, i), done))
    else go(i + 1, start, done)
  go(0, 0, nil())
}

def toInt(s: String): Option[Int] = {
  def go(i: Int, n: Int): Option[Int] =
    if (i == s.length) some(n)
    else if (s.charAt(i) < 48 || s.charAt(i) > 57) none()
    else go(i + 1, n * 10 + s.charAt(i) - 48)
  if (s.length == 0) none()
  else if (s.charAt(0) == 45) mapOption(go(1, 0), (n: Int) => 0 - n)
  else go(0, 0)
}

def upper(s: String): String = {
  def go(i: Int, done: String): String =
    if (i == s.length) done
    else {
      val c = s.charAt(i)
      go(i + 1, done + charToString(if (c >= 97 && c <= 122) c - 32 else c))
    }
  go(0, "")
}

def charToString(c: Int): String = {
  // the one-character strings, picked out of a table
  val letters = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  if (c < 32 || c > 126) "?" else letters.substring(c - 32, c - 31)
}
