// Immutable lists, folded like options are. Every function here is generic
// in the type of the elements, and the checker works out the type
// arguments: `cons(1, nil())` is a `List[Int]`.

import std.option._

type List[+A] = {
  val isEmpty: Bool
  def head(): A
  def tail(): List[A]
  def fold[R](ifNil: () => R, ifCons: (A, List[A]) => R): R
}

def nil[A](): List[A] = new List[A] {
  val isEmpty = true
  def head(): A = error("head of an empty list")
  def tail(): List[A] = error("tail of an empty list")
  def fold[R](ifNil: () => R, ifCons: (A, List[A]) => R): R = ifNil()
}

def cons[A](x: A, xs: List[A]): List[A] = new List[A] {
  val isEmpty = false
  def head(): A = x
  def tail(): List[A] = xs
  def fold[R](ifNil: () => R, ifCons: (A, List[A]) => R): R = ifCons(x, xs)
}

def headOption[A](xs: List[A]): Option[A] = if (xs.isEmpty) none() else some(xs.head())

def foldLeft[A, B](xs: List[A], z: B, f: (B, A) => B): B =
  if (xs.isEmpty) z else foldLeft(xs.tail(), f(z, xs.head()), f)

def reverse[A](xs: List[A]): List[A] = foldLeft(xs, nil[A](), (done: List[A], x: A) => cons(x, done))

def length[A](xs: List[A]): Int = foldLeft(xs, 0, (n: Int, x: A) => n + 1)

def map[A, B](xs: List[A], f: A => B): List[B] =
  reverse(foldLeft(xs, nil[B](), (done: List[B], x: A) => cons(f(x), done)))

def filter[A](xs: List[A], keep: A => Bool): List[A] =
  reverse(foldLeft(xs, nil[A](), (done: List[A], x: A) => if (keep(x)) cons(x, done) else done))

def append[A](xs: List[A], ys: List[A]): List[A] =
  foldLeft(reverse(xs), ys, (done: List[A], x: A) => cons(x, done))

def foreach[A](xs: List[A], f: A => Unit): Unit = if (xs.isEmpty) () else { f(xs.head()); foreach(xs.tail(), f) }

def range(from: Int, to: Int): List[Int] = {
  def go(n: Int, done: List[Int]): List[Int] = if (n < from) done else go(n - 1, cons(n, done))
  go(to - 1, nil())
}

def sum(xs: List[Int]): Int = foldLeft(xs, 0, (a: Int, b: Int) => a + b)

def mkString(xs: List[String], sep: String): String =
  if (xs.isEmpty) "" else foldLeft(xs.tail(), xs.head(), (done: String, s: String) => done + sep + s)
