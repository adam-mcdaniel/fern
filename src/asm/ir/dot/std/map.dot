// Maps from ordered keys, built by a functor: `sorted` takes a module that
// says how to compare keys, and gives back a module of maps with those keys.
// The maps' type is abstract outside it (`Maps` only says there is one), so
// the binary trees it's made of can't be touched, or mixed up between two
// different orderings: each result's `Map` is its own type.

import std.option._
import std.list._

type Ordering = { o =>
  type T
  def compare(a: o.T, b: o.T): Int
}

type Maps = { m =>
  type Key
  type Map[+V]
  def empty[V](): m.Map[V]
  def put[V](map: m.Map[V], k: m.Key, v: V): m.Map[V]
  def get[V](map: m.Map[V], k: m.Key): Option[V]
  def size[V](map: m.Map[V]): Int
  def keys[V](map: m.Map[V]): List[m.Key]
}

def sorted(ord: Ordering): Maps { type Key = ord.T } = new {
  type Key = ord.T
  type Map[+V] = {
    val isEmpty: Bool
    def key(): Key
    def value(): V
    def left(): Map[V]
    def right(): Map[V]
  }
  def empty[V](): Map[V] = new Map[V] {
    val isEmpty = true
    def key(): Key = error("an empty map has no key")
    def value(): V = error("an empty map has no value")
    def left(): Map[V] = error("an empty map has no branches")
    def right(): Map[V] = error("an empty map has no branches")
  }
  def node[V](k: Key, v: V, l: Map[V], r: Map[V]): Map[V] = new Map[V] {
    val isEmpty = false
    def key(): Key = k
    def value(): V = v
    def left(): Map[V] = l
    def right(): Map[V] = r
  }
  def put[V](map: Map[V], k: Key, v: V): Map[V] =
    if (map.isEmpty) node(k, v, map, map)
    else {
      val c = ord.compare(k, map.key())
      if (c < 0) node(map.key(), map.value(), put(map.left(), k, v), map.right())
      else if (c > 0) node(map.key(), map.value(), map.left(), put(map.right(), k, v))
      else node(k, v, map.left(), map.right())
    }
  def get[V](map: Map[V], k: Key): Option[V] =
    if (map.isEmpty) none()
    else {
      val c = ord.compare(k, map.key())
      if (c < 0) get(map.left(), k) else if (c > 0) get(map.right(), k) else some(map.value())
    }
  def size[V](map: Map[V]): Int = if (map.isEmpty) 0 else size(map.left()) + 1 + size(map.right())
  def keys[V](map: Map[V]): List[Key] = {
    def go(m: Map[V], done: List[Key]): List[Key] =
      if (m.isEmpty) done else go(m.left(), cons(m.key(), go(m.right(), done)))
    go(map, nil())
  }
}

val ints = new { type T = Int; def compare(a: Int, b: Int): Int = a - b }

val strings = new {
  type T = String
  def compare(a: String, b: String): Int = {
    def go(i: Int): Int =
      if (i == a.length || i == b.length) a.length - b.length
      else if (a.charAt(i) != b.charAt(i)) a.charAt(i) - b.charAt(i)
      else go(i + 1)
    go(0)
  }
}
