// Optional values. An option is an object that knows which it is, and how
// to fold itself: a Church encoding, which is how DOT does algebraic data
// types. `A` is the type of what's inside: the type member `A` of an
// `Option[A]`, which can only get more general (`+`), so `none()`, an
// `Option[Bot]`, is an option of anything.

type Option[+A] = {
  val isEmpty: Bool
  def get(): A
  def fold[R](ifNone: () => R, ifSome: A => R): R
}

def none[A](): Option[A] = new Option[A] {
  val isEmpty = true
  def get(): A = error("get of none")
  def fold[R](ifNone: () => R, ifSome: A => R): R = ifNone()
}

def some[A](x: A): Option[A] = new Option[A] {
  val isEmpty = false
  def get(): A = x
  def fold[R](ifNone: () => R, ifSome: A => R): R = ifSome(x)
}

def getOrElse[A](o: Option[A], default: A): A = if (o.isEmpty) default else o.get()

def mapOption[A, B](o: Option[A], f: A => B): Option[B] = if (o.isEmpty) none() else some(f(o.get()))

def flatMapOption[A, B](o: Option[A], f: A => Option[B]): Option[B] = if (o.isEmpty) none() else f(o.get())
